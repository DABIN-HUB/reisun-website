---
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/reisun/PageIntro.astro';
---

<Layout
  metadata={{
    title: '页面未找到',
    description: '该页面不存在，请返回 REISUN 首页或浏览软件开发服务。',
    robots: { index: false },
  }}
>
  <PageIntro
    label="404 · 页面未找到"
    title="这里暂时没有你要找的内容"
    description="链接可能已变更，也可能是地址输入有误。你可以返回首页，或从导航继续了解开发服务与演示案例。"
  />
  <div class="rs-container rs-section"><a class="rs-button" href="/">返回首页</a></div>
</Layout>
