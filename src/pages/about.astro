---
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/reisun/PageIntro.astro';
import SystemPreview from '~/components/reisun/SystemPreview.astro';
import CTA from '~/components/reisun/CTA.astro';
import { brand, getConfirmedProfile } from '~/data/brand';
const legalName = getConfirmedProfile('legalName');
const location = getConfirmedProfile('location');

const metadata = {
  title: '关于与合作方式',
  description: `${brand.description ?? ''}了解品牌定位、需求准备、阶段交付与合作边界。`,
};

const capabilities = [
  {
    title: '使用与协同',
    description: '围绕使用角色组织界面，让操作路径、权限和业务状态清楚可见。',
    tags: ['Web 管理端', '移动端应用', '业务工作台'],
  },
  {
    title: '业务与数据',
    description: '把业务规则放进明确的模块，让流程、数据与接口有可维护的边界。',
    tags: ['业务流程', '权限模型', '数据服务'],
  },
  {
    title: '设备与系统连接',
    description: '关注数据从哪里来、经过什么处理，以及异常时如何定位与恢复。',
    tags: ['工业数据采集', '接口集成', '状态可观测'],
  },
];

const principles = [
  {
    title: '先理解问题，再选择技术',
    description: '先讨论谁在使用、哪里受阻、怎样算完成。技术方案应当解释业务问题，而不是增加一层术语。',
  },
  {
    title: '把边界说在前面',
    description: '明确本期做什么、不做什么，以及依赖哪些条件。范围变化应当被看见，而不是留到交付时猜测。',
  },
  {
    title: '为后续维护留下线索',
    description: '代码结构、接口说明和关键决策同样属于交付。让系统不仅可以使用，也便于理解与继续演进。',
  },
];

const workingSteps = [
  { title: '梳理场景', description: '了解业务现状、使用角色与当前卡点。', output: '形成问题与目标清单' },
  { title: '明确方案', description: '讨论核心流程、实现路径与本期边界。', output: '对齐原型与交付范围' },
  { title: '分段实现', description: '按约定里程碑展示可讨论的阶段成果。', output: '及时确认反馈与变更' },
  { title: '交付与交接', description: '围绕约定范围确认功能与使用说明。', output: '交接代码、文档与部署说明' },
];
---

<Layout metadata={metadata}>
  <PageIntro
    variant="about"
    label="关于 REISUN"
    title="把业务理解，落实为清晰的系统。"
    description="关注真实使用场景，以明确的边界、可讨论的方案和便于维护的实现，推进软件定制开发。"
  />

  <section class="rs-section" aria-labelledby="brand-heading">
    <div class="rs-container brand-intro">
      <div class="brand-story">
        <p class="brand-positioning">{brand.positioning}</p>
        <h2 id="brand-heading">不止是写代码，<br />更是把问题理清楚。</h2>
        <p>
          {brand.name}
          {brand.positioning}。围绕企业 Java 应用、工业设备数据接入和系统集成需求，讨论从业务规则到软件实现的定制范围。
        </p>
        <p>
          业务流程难线上化、设备数据难汇集，或既有系统需要维护升级，都可以从一段具体流程和一份资料清单开始。先厘清业务规则、运行环境与外部依赖，再约定阶段成果。
        </p>
        <p class="brand-boundary">
          品牌定位不等同于已登记的企业主体。具体合作主体、技术实现范围、源码与文档交接、维护责任，以正式约定为准；本站概念案例不是商业交付记录。
        </p>
        {legalName && <p>经确认的合作主体：{legalName}</p>}
        {location && <p>经确认的所在地：{location}</p>}
        <a class="rs-link brand-services" href="/services">了解服务方向</a>
      </div>
      <figure class="brand-visual">
        <div class="brand-visual-title">
          <span>{brand.name}</span>
          <p>从业务场景，到系统结构</p>
        </div>
        <ol class="brand-context" aria-label="从业务场景到系统结构的理解路径">
          <li>业务场景</li>
          <li>流程与数据</li>
          <li>系统结构</li>
        </ol>
        <SystemPreview variant="enterprise" compact />
        <figcaption>系统架构概念示意，不代表已上线的客户项目。</figcaption>
      </figure>
    </div>
  </section>

  <section class="rs-section rs-section-soft" aria-labelledby="capabilities-heading">
    <div class="rs-container">
      <div class="rs-section-heading">
        <h2 id="capabilities-heading">围绕一条完整的业务链路</h2>
        <p>界面、规则、数据与连接，不是孤立的技术清单，而是同一个系统的不同层次。</p>
      </div>
      <div class="capability-layout">
        <div class="capability-stack" aria-label="技术能力分层">
          {
            capabilities.map((capability) => (
              <article class="capability-layer">
                <div class="capability-name">
                  <span class="layer-mark" aria-hidden="true" />
                  <h3>{capability.title}</h3>
                </div>
                <div class="capability-content">
                  <p>{capability.description}</p>
                  <ul class="rs-tags" aria-label={`${capability.title}关注方向`}>
                    {capability.tags.map((tag) => (
                      <li class="rs-tag">{tag}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
        <aside class="technology-note" aria-labelledby="technology-heading">
          <h3 id="technology-heading">按场景讨论技术方向</h3>
          <dl>
            <div><dt>前端与交互</dt><dd>Vue、TypeScript 与响应式界面</dd></div>
            <div><dt>后端与规则</dt><dd>Java、Spring Boot 与业务模块设计</dd></div>
            <div><dt>数据与连接</dt><dd>关系型数据、系统接口与设备数据集成</dd></div>
          </dl>
          <p>以上为拟讨论的开发方向，不是已交付产品清单。选型和实现范围需结合实际资料、原型与联调确认。</p>
        </aside>
      </div>
    </div>
  </section>

  <section class="rs-section" aria-labelledby="principles-heading">
    <div class="rs-container principles-layout">
      <div class="rs-section-heading">
        <h2 id="principles-heading">对开发的三个坚持</h2>
        <p>少一点模糊承诺，多一点可以确认的事情。</p>
      </div>
      <div class="principles-grid">
        {
          principles.map((principle) => (
            <article class="principle">
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="rs-section rs-section-dark working-method" aria-labelledby="method-heading">
    <div class="rs-container">
      <div class="rs-section-heading">
        <h2 id="method-heading">把合作过程，变成可确认的步骤</h2>
        <p>建议以小范围、清晰目标开始，在每个阶段对齐理解，再推进下一步。</p>
      </div>
      <ol class="working-steps">
        {
          workingSteps.map((step, index) => (
            <li>
              <span class="step-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
              <span class="step-output">{step.output}</span>
            </li>
          ))
        }
      </ol>
      <p class="working-note">以上是工作方式说明；具体阶段、交付物与验收标准需在项目开始前共同确认。</p>
    </div>
  </section>

  <CTA
    title="先把需求聊清楚，再决定如何开始。"
    description="从业务场景、使用角色和当前卡点出发，明确一个可以讨论、可以验收的起点。"
  />
</Layout>

<style>
  .brand-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
  }
  .brand-story {
    min-width: 0;
    max-width: 520px;
  }
  .brand-positioning {
    color: var(--rs-blue, #245eea);
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 16px;
  }
  .brand-story h2 {
    color: var(--rs-ink, #172b46);
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.5;
    font-weight: 650;
    letter-spacing: -0.025em;
  }
  .brand-story > p:not(.brand-positioning) {
    margin-top: 20px;
    color: var(--rs-muted, #5b6b80);
    line-height: 1.85;
  }
  .brand-story .brand-boundary {
    padding: 12px 0 12px 16px;
    border-left: 2px solid var(--rs-line, #dce4ef);
    font-size: 14px;
  }
  .brand-services {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 16px;
  }
  .brand-visual {
    min-width: 0;
    margin: 0;
    padding: 24px 24px 20px;
    background: var(--rs-soft, #f4f7fb);
    border: 1px solid var(--rs-line, #dce4ef);
    border-radius: 12px;
  }
  .brand-visual-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-bottom: 20px;
  }
  .brand-visual-title span {
    color: var(--rs-navy, #102b50);
    font-size: 20px;
    font-weight: 750;
    letter-spacing: 0.04em;
  }
  .brand-context {
    display: flex;
    align-items: center;
    margin: 0 0 20px;
    padding: 14px 0;
    border-block: 1px solid var(--rs-line, #dce4ef);
    list-style: none;
  }
  .brand-context li {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 12px;
    color: #405a7d;
    font-size: 13px;
    font-weight: 550;
    line-height: 1.8;
    white-space: nowrap;
  }
  .brand-context li + li::before {
    content: '';
    width: 18px;
    height: 1px;
    background: #a9bbd2;
  }
  .brand-visual-title p,
  figcaption {
    color: var(--rs-muted, #5b6b80);
    font-size: 13px;
    line-height: 1.7;
  }
  figcaption {
    margin-top: 18px;
  }
  .capability-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: 36px;
    align-items: start;
  }
  .capability-stack {
    background: white;
    border: 1px solid var(--rs-line, #dce4ef);
    border-radius: 10px;
    overflow: hidden;
  }
  .capability-layer {
    display: grid;
    grid-template-columns: minmax(130px, 0.65fr) minmax(0, 1.6fr);
    gap: 20px;
    padding: 26px;
  }
  .capability-layer + .capability-layer {
    border-top: 1px solid var(--rs-line, #dce4ef);
  }
  .capability-name {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .layer-mark {
    flex: 0 0 10px;
    width: 10px;
    height: 10px;
    margin-top: 10px;
    border: 2px solid var(--rs-blue, #245eea);
    border-radius: 2px;
  }
  .capability-name h3,
  .technology-note h3,
  .principle h3 {
    font-size: 18px;
    font-weight: 650;
    line-height: 1.6;
    color: var(--rs-ink, #172b46);
  }
  .capability-content p,
  .principle p {
    color: var(--rs-muted, #5b6b80);
    line-height: 1.85;
  }
  .capability-content .rs-tags {
    margin-top: 14px;
  }
  .technology-note {
    padding: 8px 0 8px 26px;
    border-left: 2px solid var(--rs-blue, #245eea);
  }
  .technology-note dl {
    margin-top: 22px;
    display: grid;
    gap: 20px;
  }
  .technology-note dt {
    color: var(--rs-ink, #172b46);
    font-size: 14px;
    font-weight: 600;
  }
  .technology-note dd {
    margin-top: 4px;
    color: var(--rs-muted, #5b6b80);
    font-size: 14px;
    line-height: 1.8;
  }
  .technology-note > p {
    color: var(--rs-muted, #5b6b80);
    font-size: 13px;
    line-height: 1.8;
    margin-top: 24px;
  }
  .principles-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: start;
    gap: clamp(36px, 6vw, 80px);
  }
  .principles-layout .rs-section-heading {
    display: block;
    margin-bottom: 0;
  }
  .principles-grid {
    display: grid;
    min-width: 0;
    gap: 24px;
  }
  .principle {
    border-top: 1px solid var(--rs-line, #dce4ef);
    padding-top: 22px;
  }
  .principle:first-child {
    border-top-color: #245eea;
  }
  .principle p {
    margin-top: 14px;
  }
  .working-method .rs-section-heading h2 {
    color: white;
  }
  .working-method .rs-section-heading p {
    color: #bed0e5;
  }
  .working-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding: 0;
    list-style: none;
  }
  .working-steps li {
    min-width: 0;
    padding: 0 24px;
    border-left: 1px solid #365173;
  }
  .working-steps li:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .working-steps li:last-child {
    padding-right: 0;
  }
  .step-number {
    display: block;
    margin-bottom: 22px;
    color: #63d7e7;
    font-size: 16px;
    font-weight: 650;
  }
  .working-steps h3 {
    color: white;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.6;
  }
  .working-steps p {
    margin-top: 12px;
    color: #c8d7e9;
    font-size: 14px;
    line-height: 1.85;
  }
  .step-output {
    display: block;
    color: #8cdde8;
    margin-top: 20px;
    font-size: 13px;
    line-height: 1.8;
  }
  .working-note {
    color: #b6c9e0;
    font-size: 13px;
    line-height: 1.8;
    margin-top: 34px;
  }
  .brand-services:focus-visible {
    outline: 3px solid var(--rs-blue, #245eea);
    outline-offset: 4px;
    border-radius: 3px;
  }
  @media (max-width: 1023px) {
    .brand-intro {
      grid-template-columns: minmax(0, 1fr);
    }
    .brand-story {
      max-width: 720px;
    }
    .brand-visual {
      max-width: 720px;
      width: 100%;
    }
    .principles-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .capability-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .technology-note dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
    .working-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 30px 0;
    }
    .working-steps li:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
  }
  @media (max-width: 639px) {
    .brand-visual {
      padding: 16px;
    }
    .brand-context {
      margin-bottom: 16px;
      padding-block: 12px;
    }
    .brand-context li {
      gap: 6px;
      font-size: 12px;
    }
    .brand-context li + li::before {
      width: 10px;
    }
    .capability-layer {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      padding: 22px 18px;
    }
    .technology-note {
      padding-left: 18px;
    }
    .technology-note dl {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
    .principles-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .principle {
      padding-top: 20px;
    }
    .working-steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
    }
    .working-steps li,
    .working-steps li:first-child,
    .working-steps li:nth-child(odd) {
      border-left: 2px solid #365173;
      padding: 0 0 0 20px;
    }
    .step-number {
      margin-bottom: 8px;
    }
    .step-output {
      margin-top: 12px;
    }
  }
</style>
