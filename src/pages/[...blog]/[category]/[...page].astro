---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogCategoryRobots, getStaticPathsBlogCategory } from '~/utils/blog';
import Layout from '~/layouts/PageLayout.astro';
import Archive from '~/components/blog/Archive.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';

export const prerender = true;
export const getStaticPaths = (async ({ paginate }) =>
  await getStaticPathsBlogCategory({ paginate })) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page, category } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;
const breadcrumbs = [
  { text: '首页', href: getPermalink('/') },
  { text: '技术文章', href: getBlogPermalink() },
  ...(currentPage > 1
    ? [{ text: category.title, href: getPermalink(category.slug, 'category') }, { text: `第 ${currentPage} 页` }]
    : [{ text: category.title }]),
];
const metadata = {
  title: `${category.title}相关文章${currentPage > 1 ? ` · 第 ${currentPage} 页` : ''}`,
  description: `浏览「${category.title}」分类下的中文技术演示文章，了解设计方法、实施边界与落地注意事项。`,
  robots: { index: blogCategoryRobots?.index, follow: blogCategoryRobots?.follow },
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>
  <Breadcrumbs bar items={breadcrumbs} />
  <Archive
    title={category.title}
    description={`围绕${category.title}整理的实用技术笔记：先说清问题，再讨论方案、取舍与实施边界。`}
    posts={page.data}
    {currentPage}
    lastPage={page.lastPage}
    total={page.total}
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
    {category}
  />
</Layout>
