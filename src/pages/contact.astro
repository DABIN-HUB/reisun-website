---
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/reisun/PageIntro.astro';
import { brand, getConfirmedContact, getConfirmedProfile, hasConfirmedContact } from '~/data/brand';

const phone = getConfirmedContact('phone');
const email = getConfirmedContact('email');
const wechat = getConfirmedContact('wechat');
const wechatQrCode = getConfirmedContact('wechatQrCode');
const github = getConfirmedProfile('github');
const channelsReady = hasConfirmedContact();

const metadata = {
  title: '联系合作与开发需求准备',
  description:
    '通过微信或邮箱联系 REISUN，交流软件开发需求与技术方案。了解沟通前可准备的资料；在线表单仅作演示，不发送或保存填写内容。',
};

const preparation = [
  { title: '现状与目标', description: '说明使用角色、当前流程和优先问题，可先整理脱敏页面或业务单据。' },
  { title: '技术与接入资料', description: '按方向准备设备型号与点表、已有系统接口说明或移动端业务路径。' },
  { title: '范围与实施约束', description: '列出优先功能、时间预算、部署条件和验收预期，不在演示表单提交真实资料。' },
];

const projectTypes = [
  '企业管理系统',
  '工业数据采集与系统集成',
  '合同与业务流程系统',
  '移动端与小程序',
  '品牌网站与 Web 应用',
  '其他 / 需要一起梳理',
];
---

<Layout metadata={metadata}>
  <PageIntro
    variant="contact"
    label="联系 REISUN"
    title="从一个具体需求开始。"
    description="不必先写好一份完整的需求文档。说说业务现状、当前卡点和想要改变的事，就是一个清晰的起点。"
  />

  <section class="rs-section contact-section" aria-labelledby="contact-heading">
    <div class="rs-container">
      <div class="contact-notice" role="note">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle><path d="M12 11v6m0-10v1"></path>
        </svg>
        <div>
          <h2 id="contact-heading">{channelsReady ? '通过正式渠道联系' : '联系渠道尚待配置'}</h2>
          <p>{brand.contact.notice}</p>
          <p>请通过微信或邮件沟通实际需求，不要在演示表单填写敏感资料。</p>
        </div>
      </div>

      <section class="requirements-guide" aria-labelledby="guide-heading">
        <h2 id="guide-heading">可以先想清楚这几件事</h2>
        <dl class="preparation-list">
          {
            preparation.map((item) => (
              <div>
                <dt>{item.title}</dt>
                <dd>{item.description}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <div class="contact-layout">
        <div class="contact-main">
          <reisun-contact-demo data-demo-message={brand.contact.formNotice}>
            <section class="request-panel" aria-labelledby="request-heading">
              <div class="request-heading">
                <h2 id="request-heading">描述你的项目需求</h2>
                <span>前端演示</span>
              </div>
              <p class="form-explanation" id="request-explanation">
                仅体验输入与提示，不会发送请求，也不会由本页面保存到浏览器。请勿填写敏感资料，建议使用示例内容。
              </p>
              <!-- 无脚本时字段和按钮都停用；脚本先绑定拦截，再启用交互。 -->
              <form method="post" novalidate autocomplete="off" aria-describedby="request-explanation">
                <fieldset disabled>
                  <legend class="sr-only">项目需求信息（仅演示，不提交）</legend>
                  <div class="form-fields">
                    <div class="form-field">
                      <label for="request-name">称呼</label>
                      <input id="request-name" name="name" type="text" placeholder="如何称呼您（可使用昵称）" />
                    </div>
                    <div class="form-field">
                      <label for="request-contact">联系方式</label>
                      <input
                        id="request-contact"
                        name="contact"
                        type="text"
                        placeholder="邮箱或微信（仅演示，请使用示例内容）"
                        aria-describedby="contact-field-note"
                      />
                      <p id="contact-field-note" class="field-note">当前不会据此联系您，无需填写真实信息。</p>
                    </div>
                    <div class="form-field form-field-wide">
                      <label for="request-project-type">项目类型</label>
                      <select id="request-project-type" name="projectType">
                        <option value="">请选择项目方向</option>
                        {projectTypes.map((type) => <option value={type}>{type}</option>)}
                      </select>
                    </div>
                    <div class="form-field form-field-wide">
                      <label for="request-description">需求描述</label>
                      <textarea
                        id="request-description"
                        name="description"
                        rows="6"
                        placeholder="例如：目前通过表格管理业务，希望把录入、审批和查询集中到一个系统。"></textarea>
                    </div>
                  </div>
                  <div class="form-actions">
                    <button class="rs-button" type="submit" disabled>演示提交需求</button>
                    <p>点击后仅展示演示模式说明，不会提交成功。</p>
                  </div>
                </fieldset>
              </form>
              <noscript>
                <p class="no-script-note">
                  浏览器未启用 JavaScript，演示表单已停用，以避免误传输入内容。请通过本页公开的微信或邮箱联系。
                </p>
              </noscript>
              <p
                class="form-status"
                data-form-status
                role="status"
                aria-live="polite"
                aria-atomic="true"
                tabindex="-1"
                hidden
              >
              </p>
            </section>
          </reisun-contact-demo>
        </div>

        <aside class="contact-aside" aria-labelledby="channels-heading">
          <section class="channels-panel">
            <div class="channels-heading">
              <h2 id="channels-heading">正式联系方式</h2>
              <span>{channelsReady ? '微信 / 邮箱' : '暂未提供'}</span>
            </div>
            <p class="channels-intro">可发送邮件，或在微信中搜索下方微信号。</p>
            <dl class="contact-channels">
              {
                phone && (
                  <div>
                    <dt>
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="m5 3 4 1 1 5-2 2a14 14 0 0 0 5 5l2-2 5 1 1 4c-1 3-5 3-8 1S4 14 3 9s-1-5 2-6Z" />
                      </svg>
                      电话
                    </dt>
                    <dd>
                      <a href={`tel:${phone}`}>{phone}</a>
                    </dd>
                  </div>
                )
              }
              <div>
                <dt>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
                    ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg
                  >
                  邮箱
                </dt>
                <dd>
                  {
                    email ? (
                      <a class="rs-link" href={`mailto:${email}`}>
                        {email}
                      </a>
                    ) : (
                      '待配置'
                    )
                  }
                </dd>
              </div>
              <div>
                <dt>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
                    ><path d="M21 11a8 8 0 0 1-8 8H8l-5 3 1-6a8 8 0 1 1 17-5Z"></path><path d="M8 10h8m-8 4h5"
                    ></path></svg
                  >
                  微信
                </dt>
                <dd>{wechat ?? '待配置'}</dd>
              </div>
            </dl>
            {
              github && (
                <p class="channels-intro">
                  <a class="rs-link" href={github} target="_blank" rel="noopener noreferrer">
                    查看已确认的 GitHub 主页
                  </a>
                </p>
              )
            }
          </section>

          {
            wechatQrCode && (
              <figure class="wechat-panel">
                <a
                  class="wechat-qr-link"
                  href={wechatQrCode}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="查看微信联系二维码原图（新窗口）"
                >
                  <img
                    class="wechat-image"
                    src={wechatQrCode}
                    alt="REISUN 正式联系微信二维码"
                    width="192"
                    height="192"
                    loading="lazy"
                  />
                </a>
                <figcaption>
                  <>
                    <strong>微信沟通</strong>
                    <span>微信扫一扫，或点击图片查看原图。</span>
                  </>
                </figcaption>
              </figure>
            )
          }

          <div class="scope-note">
            <h3>先确认范围，再讨论实现</h3>
            <p>可先了解服务方向和方案思路。涉及账号、生产数据或商业机密的资料，请在正式确认沟通方式后再提供。</p>
            <a class="rs-link" href="/services">查看服务与交付内容</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script>
  class ReisunContactDemo extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      this.controller?.abort();
      const form = this.querySelector<HTMLFormElement>('form');
      const fieldset = this.querySelector<HTMLFieldSetElement>('fieldset');
      const button = this.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = this.querySelector<HTMLElement>('[data-form-status]');
      if (!form || !fieldset || !button || !status) return;

      this.controller = new AbortController();
      form.addEventListener(
        'submit',
        (event) => {
          event.preventDefault();
          status.textContent = this.dataset.demoMessage ?? '当前为演示模式，暂未开通在线提交，请通过正式联系方式联系。';
          status.hidden = false;
          status.focus();
        },
        { signal: this.controller.signal }
      );

      fieldset.disabled = false;
      button.disabled = false;
    }

    disconnectedCallback() {
      this.controller?.abort();
      const fieldset = this.querySelector<HTMLFieldSetElement>('fieldset');
      const button = this.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (fieldset) fieldset.disabled = true;
      if (button) button.disabled = true;
    }
  }

  if (!customElements.get('reisun-contact-demo')) {
    customElements.define('reisun-contact-demo', ReisunContactDemo);
  }
</script>

<style>
  .contact-section {
    padding-top: 40px;
  }
  .contact-notice {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 20px 24px;
    margin-bottom: 36px;
    border: 1px solid #cad9f5;
    border-radius: 6px;
    background: #f4f7fb;
    color: #294972;
  }
  .contact-notice > svg {
    flex: 0 0 22px;
    width: 22px;
    height: 22px;
    margin-top: 3px;
    stroke: #245eea;
    stroke-width: 1.7;
    stroke-linecap: round;
  }
  .contact-notice h2 {
    font-size: 16px;
    font-weight: 650;
    line-height: 1.7;
  }
  .contact-notice p {
    margin-top: 5px;
    font-size: 14px;
    line-height: 1.85;
  }
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.9fr);
    align-items: start;
    gap: clamp(28px, 4vw, 48px);
  }
  .contact-main,
  .contact-aside {
    min-width: 0;
  }
  .requirements-guide {
    margin-bottom: 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--rs-line, #dce4ef);
  }
  .requirements-guide h2,
  .request-heading h2,
  .channels-panel h2 {
    color: var(--rs-ink, #172b46);
    font-size: clamp(21px, 2.1vw, 26px);
    font-weight: 650;
    line-height: 1.6;
  }
  .preparation-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    margin-top: 22px;
  }
  .preparation-list > div {
    min-width: 0;
    padding-left: 16px;
    border-left: 2px solid #cad9f5;
  }
  .preparation-list dt {
    color: var(--rs-ink, #172b46);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.8;
  }
  .preparation-list dd {
    margin-top: 7px;
    color: var(--rs-muted, #5b6b80);
    font-size: 14px;
    line-height: 1.8;
  }
  reisun-contact-demo {
    display: block;
  }
  .request-panel {
    border: 1px solid var(--rs-line, #dce4ef);
    border-top: 3px solid var(--rs-blue, #245eea);
    border-radius: 12px;
    padding: 30px;
    background: white;
  }
  .request-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 16px;
  }
  .request-heading > span {
    display: inline-block;
    flex-shrink: 0;
    padding: 3px 9px;
    background: #edf3ff;
    color: #2b56a8;
    border-radius: 4px;
    font-size: 12px;
    line-height: 1.7;
  }
  .form-explanation {
    text-wrap: balance;
    margin: 14px 0 26px;
    padding-left: 12px;
    border-left: 2px solid #cad9f5;
    color: #405a7d;
    font-size: 14px;
    line-height: 1.85;
  }
  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .form-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 20px;
  }
  .form-field {
    min-width: 0;
  }
  .form-field-wide {
    grid-column: 1 / -1;
  }
  label {
    display: block;
    margin-bottom: 9px;
    color: var(--rs-ink, #172b46);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.7;
  }
  input,
  select,
  textarea {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 48px;
    border: 1px solid #c9d5e5;
    border-radius: 6px;
    padding: 11px 12px;
    background: white;
    color: #172b46;
    font: inherit;
    font-size: 16px;
    line-height: 1.6;
  }
  input::placeholder,
  textarea::placeholder {
    color: #6b7c92;
    opacity: 1;
  }
  textarea {
    min-height: 168px;
    resize: vertical;
  }
  select {
    padding-right: 30px;
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid #245eea;
    outline-offset: 3px;
    border-color: #245eea;
  }
  fieldset:disabled input,
  fieldset:disabled select,
  fieldset:disabled textarea {
    background: #f4f7fb;
    color: #65758b;
    cursor: not-allowed;
  }
  .field-note {
    margin-top: 8px;
    color: var(--rs-muted, #5b6b80);
    font-size: 12px;
    line-height: 1.8;
  }
  .form-actions {
    margin-top: 26px;
    padding-top: 22px;
    border-top: 1px solid var(--rs-line, #dce4ef);
  }
  .form-actions button {
    min-width: 160px;
    min-height: 48px;
  }
  .form-actions button:disabled {
    background: #e3e9f1;
    color: #55657c;
    border-color: #ccd7e5;
    cursor: not-allowed;
  }
  .form-actions button:focus-visible,
  .scope-note a:focus-visible,
  .wechat-qr-link:focus-visible {
    outline: 3px solid #245eea;
    outline-offset: 4px;
  }
  .form-actions > p {
    margin-top: 12px;
    color: var(--rs-muted, #5b6b80);
    font-size: 12px;
    line-height: 1.8;
  }
  .form-status {
    margin-top: 22px;
    padding: 16px;
    border: 1px solid #b9cdf0;
    border-radius: 6px;
    background: #edf3ff;
    color: #23477d;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }
  .form-status:focus {
    outline: 3px solid #245eea;
    outline-offset: 3px;
  }
  .form-status[hidden] {
    display: none;
  }
  .no-script-note {
    margin-top: 20px;
    border-left: 3px solid #245eea;
    padding-left: 14px;
    color: #294972;
    font-size: 14px;
    line-height: 1.85;
  }
  .channels-panel {
    padding: 28px;
    background: var(--rs-soft, #f4f7fb);
    border: 1px solid var(--rs-line, #dce4ef);
    border-radius: 10px;
  }
  .channels-heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
  }
  .channels-heading > span {
    padding: 2px 8px;
    border: 1px dashed #a9bbd2;
    border-radius: 4px;
    color: #4f6581;
    font-size: 12px;
    line-height: 1.8;
  }
  .channels-panel h2 {
    color: var(--rs-ink, #172b46);
    font-size: 22px;
  }
  .channels-intro {
    margin-top: 10px;
    color: var(--rs-muted, #5b6b80);
    font-size: 14px;
    line-height: 1.85;
  }
  .contact-channels {
    margin-top: 24px;
  }
  .contact-channels > div {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 20px;
    padding: 16px 0;
    border-top: 1px solid var(--rs-line, #dce4ef);
  }
  .contact-channels > div:last-child {
    padding-bottom: 0;
  }
  .contact-channels dt {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #405a7d;
    font-size: 14px;
  }
  .contact-channels svg {
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
    stroke: #657c9a;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .contact-channels dd {
    padding: 3px 10px;
    border-radius: 4px;
    background: #e7edf5;
    color: #4f6581;
    font-size: 14px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .wechat-panel {
    display: grid;
    justify-items: center;
    gap: 16px;
    margin: 24px 0 0;
    padding: 20px;
    border: 1px solid var(--rs-line, #dce4ef);
    border-radius: 10px;
    background: white;
  }
  .wechat-qr-link {
    display: block;
    width: min(100%, 192px);
  }
  .wechat-image {
    width: min(100%, 192px);
    height: auto;
  }
  figcaption {
    display: grid;
    gap: 6px;
    width: 100%;
  }
  figcaption strong {
    color: var(--rs-ink, #172b46);
    font-size: 16px;
    font-weight: 600;
  }
  figcaption span {
    color: var(--rs-muted, #5b6b80);
    font-size: 13px;
    line-height: 1.8;
  }
  .scope-note {
    margin-top: 26px;
    padding: 0 4px;
  }
  .scope-note h3 {
    color: var(--rs-ink, #172b46);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.7;
  }
  .scope-note p {
    margin-top: 10px;
    color: var(--rs-muted, #5b6b80);
    font-size: 14px;
    line-height: 1.85;
  }
  .scope-note a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 10px;
  }
  @media (max-width: 1023px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 28px;
    }
    .request-panel,
    .channels-panel {
      padding: 24px;
    }
    .form-fields {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 767px) {
    .contact-section {
      padding-top: 28px;
    }
    .contact-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }
    .contact-notice {
      margin-bottom: 30px;
      padding: 18px;
      gap: 12px;
    }
    .requirements-guide {
      margin-bottom: 28px;
      padding-bottom: 26px;
    }
    .preparation-list {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
      margin-top: 20px;
    }
    .preparation-list > div {
      display: grid;
      grid-template-columns: minmax(112px, 0.55fr) minmax(0, 1.7fr);
      gap: 12px;
    }
    .preparation-list dd {
      margin-top: 0;
    }
    .form-fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .contact-aside {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .wechat-panel {
      margin: 0;
    }
    .scope-note {
      grid-column: 1 / -1;
      margin-top: 0;
    }
  }
  @media (max-width: 539px) {
    .preparation-list > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 3px;
    }
    .request-panel {
      padding: 22px 18px;
    }
    .form-fields,
    .contact-aside {
      grid-template-columns: minmax(0, 1fr);
    }
    .contact-notice {
      padding: 16px;
    }
    .channels-panel {
      padding: 24px;
    }
    .form-actions button {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    input,
    select,
    textarea,
    button {
      transition: none;
      animation: none;
    }
  }
</style>
