---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import PageLayout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/reisun/PageIntro.astro';
import CTA from '~/components/reisun/CTA.astro';
import SystemPreview from '~/components/reisun/SystemPreview.astro';
import { cases, caseDemoNotice } from '~/data/cases';
import { evidenceLabels } from '~/data/evidence';
import { services } from '~/data/services';
import { solutions } from '~/data/solutions';
import { findPostsBySlugs, isBlogEnabled, isBlogPostRouteEnabled } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

export const getStaticPaths = (() =>
  cases.map((caseStudy) => ({
    params: { slug: caseStudy.id },
    props: { caseStudy },
  }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { caseStudy } = Astro.props;
const relatedCases = cases.filter((item) => item.id !== caseStudy.id);
const relatedServices = services.filter((item) => caseStudy.serviceIds?.includes(item.id));
const relatedSolutions = solutions.filter((item) => caseStudy.solutionIds?.includes(item.id));
const relatedPosts = isBlogEnabled && isBlogPostRouteEnabled ? await findPostsBySlugs(caseStudy.postSlugs ?? []) : [];
const hasRelatedResources = relatedServices.length > 0 || relatedSolutions.length > 0 || relatedPosts.length > 0;
const chapters = [
  { id: 'background', title: '项目背景' },
  { id: 'challenges', title: '业务痛点' },
  { id: 'approach', title: '实现方案' },
  { id: 'features', title: '核心功能' },
  { id: 'architecture', title: '技术架构' },
  { id: 'screens', title: '页面展示' },
  { id: 'value', title: '项目价值' },
];
const metadata = {
  title: `${caseStudy.title}｜软件定制开发概念演示案例`,
  description: `${caseStudy.summary}了解虚拟场景的背景、痛点、方案、功能和架构选型。技术组合为设计规划，价值为预期目标，不代表客户交付或测得成果。`,
};
---

<PageLayout metadata={metadata}>
  <nav class="rs-container case-breadcrumbs" aria-label="面包屑导航">
    <a href="/">首页</a>
    <span aria-hidden="true">/</span>
    <a href="/cases">案例中心</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{caseStudy.title}</span>
  </nav>

  <PageIntro label={caseStudy.label} title={caseStudy.title} description={caseStudy.summary} />

  <section class="rs-section rs-section-soft case-overview" aria-labelledby="case-overview-title">
    <div class="rs-container">
      <h2 id="case-overview-title" class="case-overview-title">案例概览</h2>
      <p class="rs-note case-demo-notice">{caseDemoNotice}</p>
      <dl class="case-facts">
        <div>
          <dt>业务场景</dt>
          <dd>{caseStudy.category}</dd>
        </div>
        <div>
          <dt>内容性质</dt>
          <dd>
            {caseStudy.evidence ? evidenceLabels[caseStudy.evidence.status] : caseStudy.label} / 全部模拟数据
          </dd>
        </div>
        <div>
          <dt>方案范围</dt>
          <dd>
            <ul>
              {caseStudy.scope.map((item) => <li>{item}</li>)}
            </ul>
          </dd>
        </div>
        <div>
          <dt>技术设计选型（非使用记录）</dt>
          <dd>
            <ul class="rs-tags">
              {caseStudy.stack.map((technology) => <li class="rs-tag">{technology}</li>)}
            </ul>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="rs-section" aria-label="案例设计说明">
    <div class="rs-container rs-detail-grid case-detail-layout">
      <aside class="case-directory">
        <nav aria-label="案例内容目录">
          <h2>本页内容</h2>
          <ul>
            {
              chapters.map((chapter) => (
                <li>
                  <a href={`#${chapter.id}`}>{chapter.title}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        {
          hasRelatedResources && (
            <a class="rs-button rs-button-secondary case-directory-contact" href="#case-related-resources">
              查看相关内容
            </a>
          )
        }
      </aside>

      <div class="case-detail-content">
        <section class="case-chapter rs-prose" id="background" aria-labelledby="background-title">
          <h2 id="background-title">项目背景</h2>
          {caseStudy.background.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section class="case-chapter" id="challenges" aria-labelledby="challenges-title">
          <h2 id="challenges-title">业务痛点</h2>
          <ul class="case-point-list">
            {
              caseStudy.painPoints.map((point) => (
                <li>
                  <h3>{point.title}</h3>
                  <p>{point.description}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="case-chapter" id="approach" aria-labelledby="approach-title">
          <h2 id="approach-title">实现方案</h2>
          <p class="case-section-intro">以下展示面向虚拟业务场景的设计路径，不表示系统已经上线运行。</p>
          <ol class="case-approach">
            {
              caseStudy.approach.map((point) => (
                <li>
                  <h3>{point.title}</h3>
                  <p>{point.description}</p>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="case-chapter" id="features" aria-labelledby="features-title">
          <h2 id="features-title">核心功能</h2>
          <p class="case-section-intro">以下为拟设计的功能范围，不是当前可操作功能或已实现产品清单。</p>
          <div class="rs-grid-2 case-feature-grid">
            {
              caseStudy.features.map((feature) => (
                <article class="rs-card case-feature">
                  <h3>{feature.title}</h3>
                  <p>{feature.description}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section class="case-chapter" id="architecture" aria-labelledby="architecture-title">
          <h2 id="architecture-title">技术架构</h2>
          <p class="case-section-intro">
            以下技术栈与分层均为概念方案的设计选型，不是实际使用记录。本站界面由 Astro
            静态组件呈现，不运行这些业务后端；实际选型需另行评估。
          </p>
          <ul class="case-architecture">
            {
              caseStudy.architecture.map((layer) => (
                <li>
                  <div class="case-layer-heading">
                    <h3>{layer.layer}</h3>
                    <p class="case-layer-technology">{layer.technology}</p>
                  </div>
                  <p>{layer.description}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="case-chapter" id="screens" aria-labelledby="screens-title">
          <h2 id="screens-title">页面展示</h2>
          <p class="case-section-intro">
            下方为代表性的原创概念示意，后续文字说明页面规划，并非每项规划都已有对应界面。示意不是实际交付截图，也不连接业务系统。
          </p>
          <figure class="case-screen-figure">
            <SystemPreview variant={caseStudy.variant} />
            <figcaption>{caseStudy.title}：原创系统概念示意，页面内容与读数均为模拟数据。</figcaption>
          </figure>
          <div class="case-screen-notes" aria-label="页面规划说明">
            {
              caseStudy.screens.map((screen) => (
                <article>
                  <h3>{screen.title}</h3>
                  <p>{screen.description}</p>
                  <ul class="rs-tags" aria-label={`${screen.title}设计要点`}>
                    {screen.highlights.map((highlight) => (
                      <li class="rs-tag">{highlight}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </section>

        <section class="case-chapter" id="value" aria-labelledby="value-title">
          <h2 id="value-title">项目价值</h2>
          <p class="case-section-intro">
            以下为预期设计目标，不是测得成果；本轮未获得足够证据确认真实效率提升、收益或客户交付。
          </p>
          <ul class="case-point-list">
            {
              caseStudy.value.map((point) => (
                <li>
                  <h3>{point.title}</h3>
                  <p>{point.description}</p>
                </li>
              ))
            }
          </ul>
          <aside class="case-boundary" aria-labelledby="case-boundary-title">
            <h3 id="case-boundary-title">演示范围与边界</h3>
            {caseStudy.evidence && <p>{caseStudy.evidence.summary}</p>}
            <p>{caseStudy.boundary}</p>
          </aside>
          {
            hasRelatedResources && (
              <nav class="case-resources" id="case-related-resources" aria-labelledby="case-resources-title">
                <h3 id="case-resources-title">相关服务、方案与文稿</h3>
                <p>用于继续了解拟讨论范围与设计思路，不作为本案例已实现或商业交付的证据。</p>
                {relatedServices.length > 0 && (
                  <div>
                    <h4>开发服务</h4>
                    <ul>
                      {relatedServices.map((service) => (
                        <li>
                          <a class="rs-link" href={`/services#${service.id}`}>
                            {service.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {relatedSolutions.length > 0 && (
                  <div>
                    <h4>关联解决方案</h4>
                    <ul>
                      {relatedSolutions.map((solution) => (
                        <li>
                          <a class="rs-link" href={`/solutions/${solution.id}`}>
                            {solution.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {relatedPosts.length > 0 && (
                  <div>
                    <h4>延伸阅读</h4>
                    <ul>
                      {relatedPosts.map((post) => (
                        <li>
                          <a class="rs-link" href={getPermalink(post.permalink, 'post')}>
                            {post.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </nav>
            )
          }
        </section>
      </div>
    </div>
  </section>

  <section class="rs-section rs-section-soft" aria-labelledby="related-cases-title">
    <div class="rs-container">
      <div class="rs-section-heading case-related-heading">
        <h2 id="related-cases-title">继续了解其他业务场景</h2>
        <a class="rs-link" href="/cases">返回全部演示案例</a>
      </div>
      <div class="rs-grid-3 case-related-grid">
        {
          relatedCases.map((item) => (
            <article class="rs-card case-related">
              <p class="case-related-category">{item.category}演示案例</p>
              <h3>{item.title}</h3>
              <p>{item.summary}</p>
              <a class="rs-link" href={`/cases/${item.id}`} aria-label={`查看${item.title}演示案例详情`}>
                查看案例详情
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTA
    title="把你的业务流程带来，一起明确实施边界"
    description="从使用角色、关键流程和现有系统开始，讨论需要做什么、不需要做什么，以及如何分阶段推进。"
  />
</PageLayout>

<style>
  .case-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.65rem;
    padding-top: 1.5rem;
    color: var(--rs-muted, #5b6b80);
    font-size: 0.875rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .case-breadcrumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--rs-ink, #172b46);
  }

  .case-overview-title {
    margin: 0 0 0.875rem;
    color: var(--rs-ink, #172b46);
    font-size: 1.375rem;
    font-weight: 700;
  }

  .case-demo-notice {
    max-width: 90ch;
    line-height: 1.85;
  }

  .case-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin: 2rem 0 0;
  }

  .case-facts > div,
  .case-detail-layout > *,
  .case-feature-grid > *,
  .case-related-grid > * {
    min-width: 0;
  }

  .case-facts dt {
    margin-bottom: 0.5rem;
    color: var(--rs-muted, #5b6b80);
    font-size: 0.875rem;
  }

  .case-facts dd {
    margin: 0;
    color: var(--rs-ink, #172b46);
    font-weight: 550;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .case-facts ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-facts .rs-tags,
  .case-screen-notes .rs-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .case-facts .rs-tag,
  .case-screen-notes .rs-tag {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .case-detail-layout {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .case-directory {
    position: sticky;
    top: 7rem;
    padding-left: 1rem;
    border-left: 2px solid var(--rs-line, #d9e2ef);
  }

  .case-directory h2 {
    margin: 0 0 0.75rem;
    color: var(--rs-ink, #172b46);
    font-size: 1rem;
    font-weight: 700;
  }

  .case-directory ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-directory nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--rs-muted, #5b6b80);
    line-height: 1.5;
  }

  .case-directory nav a:hover {
    color: var(--rs-blue, #245eea);
  }

  .case-directory-contact {
    margin-top: 1.25rem;
  }

  .case-chapter {
    scroll-margin-top: 7rem;
  }

  .case-chapter + .case-chapter {
    margin-top: clamp(2.75rem, 5vw, 4.5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--rs-line, #d9e2ef);
  }

  .case-chapter h2 {
    margin: 0 0 1.25rem;
    color: var(--rs-ink, #172b46);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    line-height: 1.5;
  }

  .case-chapter h3,
  .case-related h3 {
    margin: 0 0 0.5rem;
    color: var(--rs-ink, #172b46);
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.6;
  }

  .case-chapter p,
  .case-related > p {
    margin: 0;
    color: var(--rs-muted, #5b6b80);
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .case-chapter.rs-prose > p + p {
    margin-top: 1rem;
  }

  .case-chapter .case-section-intro {
    margin-bottom: 1.5rem;
  }

  .case-point-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-point-list li + li {
    margin-top: 1.75rem;
  }

  .case-approach {
    margin: 0;
    padding-left: 1.5rem;
    list-style: decimal;
  }

  .case-approach li {
    padding-left: 0.5rem;
  }

  .case-approach li::marker {
    color: var(--rs-blue, #245eea);
    font-weight: 700;
  }

  .case-approach li + li {
    margin-top: 1.75rem;
  }

  .case-feature {
    padding: clamp(1rem, 2.5vw, 1.5rem);
  }

  .case-architecture {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--rs-line, #d9e2ef);
    border-radius: 8px;
    overflow: hidden;
  }

  .case-architecture li {
    padding: clamp(1rem, 2.5vw, 1.5rem);
  }

  .case-architecture li + li {
    border-top: 1px solid var(--rs-line, #d9e2ef);
  }

  .case-layer-heading {
    margin-bottom: 0.5rem;
  }

  .case-layer-heading .case-layer-technology {
    color: var(--rs-blue, #245eea);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .case-screen-figure {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--rs-line, #d9e2ef);
    border-radius: 10px;
    background: var(--rs-soft, #f4f7fb);
  }

  .case-screen-figure figcaption {
    padding: 1rem 1.125rem;
    border-top: 1px solid var(--rs-line, #d9e2ef);
    color: var(--rs-muted, #5b6b80);
    font-size: 0.8125rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .case-screen-notes {
    margin-top: 2rem;
  }

  .case-screen-notes article + article {
    margin-top: 1.75rem;
  }

  .case-screen-notes ul {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .case-boundary {
    margin-top: 2rem;
    padding: 1.25rem;
    border-left: 3px solid var(--rs-blue, #245eea);
    background: var(--rs-soft, #f4f7fb);
  }

  .case-boundary p + p {
    margin-top: 0.75rem;
  }

  .case-resources {
    margin-top: 2rem;
    scroll-margin-top: 7rem;
  }

  .case-resources h4 {
    margin: 1.25rem 0 0.5rem;
    font-weight: 650;
  }

  .case-resources ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-resources a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    overflow-wrap: anywhere;
  }

  .case-related-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .case-related {
    display: flex;
    flex-direction: column;
    align-items: start;
  }

  .case-related .case-related-category {
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
  }

  .case-related .rs-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 1rem;
  }

  a:focus-visible {
    outline: 3px solid var(--rs-blue, #245eea);
    outline-offset: 4px;
  }

  @media (max-width: 959px) {
    .case-detail-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .case-directory {
      position: static;
    }

    .case-directory ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0 1.25rem;
    }
  }

  @media (max-width: 639px) {
    .case-facts,
    .case-feature-grid,
    .case-related-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .case-facts {
      gap: 1.5rem;
    }

    .case-breadcrumbs {
      font-size: 0.8125rem;
    }
  }
</style>
