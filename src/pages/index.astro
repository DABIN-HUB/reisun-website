---
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import StructuredData from '~/components/common/StructuredData.astro';
import HeroGraphic from '~/components/reisun/HeroGraphic.astro';
import SystemPreview from '~/components/reisun/SystemPreview.astro';
import Process from '~/components/reisun/Process.astro';
import CTA from '~/components/reisun/CTA.astro';
import BlogGrid from '~/components/blog/Grid.astro';
import { services } from '~/data/services';
import { solutions } from '~/data/solutions';
import { cases } from '~/data/cases';
import { findLatestPosts } from '~/utils/blog';
import { SITE, I18N } from 'astrowind:config';

const posts = await findLatestPosts({ count: 3 });
const featuredSolution = solutions[0];
const metadata = {
  title: 'REISUN｜专业软件定制开发与企业数字化解决方案',
  description:
    '专注 Java 企业应用、工业物联网与设备数据采集、ERP/OA、微信小程序和企业系统集成。了解 REISUN 的开发服务、演示方案与技术实践。',
  ignoreTitleTemplate: true,
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.site,
  inLanguage: I18N.language,
  description: metadata.description,
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={websiteSchema} />
  <section class="home-hero">
    <div class="rs-container hero-layout">
      <div class="hero-copy">
        <p class="hero-kicker"><span></span>软件定制开发与企业数字化</p>
        <h1>专业软件定制开发，<br />让技术真正服务业务</h1>
        <p class="hero-description">
          从工业设备的数据连接，到企业管理的高效协同。<br
            class="desktop-break"
          />以扎实的工程能力，把业务想法变成可靠的软件。
        </p>
        <div class="hero-actions">
          <Button href="/contact" text="咨询开发需求" class="rs-button" /><Button
            href="/cases"
            text="查看项目案例"
            class="rs-button rs-button-secondary hero-secondary"
          />
        </div>
        <p class="hero-scope">Java 企业应用 / 工业物联网 / ERP·OA / 微信小程序</p>
      </div>
      <HeroGraphic />
    </div>
    <div class="hero-bottom">
      <div class="rs-container hero-principles">
        <span><i></i>围绕业务设计</span><span><i></i>重视系统可靠性</span><span><i></i>关注持续演进</span><span
          class="hero-brand-note">REISUN · 独立软件开发品牌</span
        >
      </div>
    </div>
  </section>

  <section class="rs-section home-services" id="services">
    <div class="rs-container">
      <div class="rs-section-heading">
        <div>
          <h2>
            <span class="rs-heading-phrase">从业务需求出发，</span><wbr /><span class="rs-heading-phrase"
              >构建合适的软件</span
            >
          </h2><p>不止于功能实现，更关心软件如何融入日常工作，解决真正的问题。</p>
        </div><a class="rs-link" href="/services">了解开发服务 <Icon name="tabler:arrow-up-right" /></a>
      </div>
      <div class="service-grid">
        {
          services.map((service) => (
            <article class="home-service">
              <>
                <div class="service-icon">
                  <Icon name={service.icon} />
                </div>
                <h3>
                  <a href={`/services#${service.id}`}>{service.title}</a>
                </h3>
                <p>{service.summary}</p>
                <a class="rs-link" href={`/services#${service.id}`} aria-label={`了解${service.title}`}>
                  服务详情 <Icon name="tabler:chevron-right" />
                </a>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="rs-section rs-section-dark home-solutions">
    <div class="rs-container">
      <div class="rs-section-heading">
        <div>
          <h2>
            <span class="rs-heading-phrase">让技术能力，</span><wbr /><span class="rs-heading-phrase"
              >落在具体的业务场景里</span
            >
          </h2><p>连接现场、整合数据、协同流程，让不同系统成为一条完整的业务链路。</p>
        </div><a class="rs-link" href="/solutions">浏览解决方案 <Icon name="tabler:arrow-up-right" /></a>
      </div>
      <div class="solution-layout">
        <div class="featured-solution">
          <span class="solution-label">重点场景 · 工业物联网</span><h3>{featuredSolution.title}</h3><p>
            {featuredSolution.summary}
          </p><SystemPreview variant="industrial" compact /><a
            class="rs-link"
            href={`/solutions/${featuredSolution.id}`}>探索设备数据方案 <Icon name="tabler:chevron-right" /></a
          >
        </div>
        <div class="solution-list">
          {
            solutions.slice(1).map((solution) => (
              <article>
                <>
                  <span class="solution-symbol" aria-hidden="true">
                    <Icon
                      name={
                        solution.variant === 'enterprise'
                          ? 'tabler:building-factory-2'
                          : solution.variant === 'contract'
                            ? 'tabler:file-description'
                            : 'tabler:device-mobile'
                      }
                    />
                  </span>
                  <div>
                    <>
                      <h3>
                        <a href={`/solutions/${solution.id}`}>{solution.title}</a>
                      </h3>
                      <p>{solution.summary}</p>
                      <a href={`/solutions/${solution.id}`} class="rs-link">
                        查看方案 <Icon name="tabler:chevron-right" />
                      </a>
                    </>
                  </div>
                </>
              </article>
            ))
          }
        </div>
      </div>
      <p class="solution-disclaimer">方案与界面均为能力演示，实际范围与技术选型需结合项目需求确认。</p>
    </div>
  </section>

  <section class="rs-section home-cases">
    <div class="rs-container">
      <div class="rs-section-heading">
        <div>
          <h2>
            <span class="rs-heading-phrase">把能力讲清楚，</span><wbr /><span class="rs-heading-phrase"
              >不如把系统展示出来</span
            >
          </h2><p>通过四个演示项目，了解从现场数据到企业运营的实现思路。</p>
        </div><a class="rs-link" href="/cases">查看全部案例 <Icon name="tabler:arrow-up-right" /></a>
      </div>
      <div class="rs-grid-2 case-grid">
        {
          cases.map((project) => (
            <article class="home-case">
              <>
                <a class="case-visual" href={`/cases/${project.id}`} aria-label={`查看${project.title}演示案例`}>
                  <SystemPreview variant={project.variant} compact />
                </a>
                <div class="case-heading">
                  <>
                    <span>{project.category}</span>
                    <span class="case-demo">演示案例</span>
                  </>
                </div>
                <h3>
                  <a href={`/cases/${project.id}`}>{project.title}</a>
                </h3>
                <p>{project.summary}</p>
                <div class="case-meta">
                  <>
                    <div class="rs-tags">
                      {project.stack.slice(0, 3).map((item) => (
                        <span class="rs-tag">{item}</span>
                      ))}
                    </div>
                    <a href={`/cases/${project.id}`} class="case-detail" aria-label={`查看${project.title}详情`}>
                      <Icon name="tabler:arrow-up-right" />
                    </a>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <div class="rs-section-soft"><Process /></div>

  <section class="rs-section home-about">
    <div class="rs-container about-layout">
      <div><p class="about-brand">关于 REISUN</p><h2>理解业务的细节，<br />也尊重技术的边界。</h2></div><div>
        <p>
          REISUN
          是一个专注软件定制开发的独立品牌，关注企业应用、工业互联与系统集成。我们相信，好的软件不必堆砌技术，而应让业务流程更清晰，让系统长期可维护。
        </p><div class="about-method">
          <span>清晰的需求边界</span><span>务实的技术选择</span><span>可持续的工程交付</span>
        </div><a class="rs-link" href="/about">了解品牌与工作方式 <Icon name="tabler:arrow-up-right" /></a>
      </div>
    </div>
  </section>

  <section class="rs-section rs-section-soft home-articles">
    <div class="rs-container">
      <div class="rs-section-heading">
        <div>
          <h2>
            <span class="rs-heading-phrase">分享技术实践，</span><wbr /><span class="rs-heading-phrase"
              >也分享解决问题的思路</span
            >
          </h2><p>关于 Java、工业通信、系统架构与数字化建设的中文技术笔记。</p>
        </div><a class="rs-link" href="/blog">阅读全部文章 <Icon name="tabler:arrow-up-right" /></a>
      </div><BlogGrid posts={posts} />
    </div>
  </section>
  <CTA />
</Layout>

<style>
  .home-hero {
    background: #102b50;
    color: white;
    position: relative;
    overflow: hidden;
  }
  .hero-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 0;
    padding-block: 48px 42px;
    min-height: 582px;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
  }
  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: #bfdaff;
    margin-bottom: 24px;
  }
  .hero-kicker > span {
    width: 22px;
    height: 2px;
    background: var(--rs-cyan);
  }
  h1 {
    font-size: clamp(34px, 3.4vw, 50px);
    font-weight: 650;
    line-height: 1.5;
    letter-spacing: -0.04em;
  }
  .hero-description {
    font-size: 16px;
    line-height: 2;
    color: #b9cbe1;
    margin-top: 24px;
    max-width: 530px;
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 32px;
  }
  .hero-actions :global(.hero-secondary) {
    color: white;
    border-color: #637b9c;
  }
  .hero-actions :global(.hero-secondary:hover) {
    color: white;
    border-color: #a1c1ed;
    background: #ffffff0d;
  }
  .hero-scope {
    font-size: 11px;
    color: #a3bbd7;
    margin-top: 26px;
  }
  .hero-bottom {
    border-top: 1px solid #ffffff14;
  }
  .hero-principles {
    display: flex;
    align-items: center;
    gap: 44px;
    min-height: 67px;
    font-size: 12px;
    color: #c5d5e8;
  }
  .hero-principles > span {
    display: flex;
    gap: 9px;
    align-items: center;
  }
  .hero-principles i {
    height: 5px;
    width: 5px;
    border: 1px solid var(--rs-cyan);
    transform: rotate(45deg);
  }
  .hero-brand-note {
    margin-left: auto;
    color: #8da9ca;
  }
  .rs-link :global(svg) {
    width: 17px;
    height: 17px;
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 46px;
  }
  .home-service {
    padding: 32px 0 24px;
    border-top: 1px solid var(--rs-line);
  }
  .service-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: #edf3ff;
    border-radius: 8px;
    color: var(--rs-blue);
    margin-bottom: 21px;
  }
  .service-icon :global(svg) {
    width: 25px;
    height: 25px;
    stroke-width: 1.5;
  }
  .home-service h3 {
    font-size: 19px;
    font-weight: 650;
    line-height: 1.6;
  }
  .home-service h3 a:hover {
    color: var(--rs-blue);
  }
  .home-service p {
    color: var(--rs-muted);
    font-size: 14px;
    line-height: 1.9;
    margin-top: 12px;
    min-height: 54px;
  }
  .home-service .rs-link {
    font-size: 12px;
    margin-top: 6px;
  }
  .home-solutions .rs-section-heading > .rs-link,
  .home-solutions .rs-link {
    color: #9bc9ff;
  }
  .solution-layout {
    display: grid;
    grid-template-columns: 1.16fr 1fr;
    gap: 60px;
  }
  .featured-solution {
    padding: 28px 28px 12px;
    border-radius: 8px;
    background: #1a3a61;
    border: 1px solid #ffffff18;
  }
  .solution-label {
    font-size: 11px;
    color: var(--rs-cyan);
  }
  .featured-solution h3 {
    font-size: 23px;
    font-weight: 600;
    line-height: 1.5;
    margin-top: 12px;
  }
  .featured-solution > p {
    font-size: 13px;
    color: #b4c8e0;
    margin: 12px 0 22px;
  }
  .featured-solution :global(.system-preview) {
    padding: 0;
    background: none;
  }
  .featured-solution :global(figcaption) {
    color: #a4bddb;
  }
  .featured-solution > .rs-link {
    margin-top: 7px;
  }
  .solution-list {
    display: grid;
  }
  .solution-list article {
    display: flex;
    align-items: flex-start;
    gap: 22px;
    padding-block: 24px;
    border-bottom: 1px solid #ffffff24;
  }
  .solution-list article:first-child {
    padding-top: 12px;
  }
  .solution-list article:last-child {
    border-bottom: 0;
  }
  .solution-symbol {
    margin-top: 3px;
    width: 35px;
    flex-shrink: 0;
    color: #85b5f1;
  }
  .solution-symbol :global(svg) {
    width: 30px;
    height: 30px;
    stroke-width: 1.3;
  }
  .solution-list h3 {
    font-size: 20px;
    line-height: 1.55;
    font-weight: 600;
  }
  .solution-list p {
    color: #b7c9df;
    font-size: 14px;
    margin-top: 10px;
    line-height: 1.85;
  }
  .solution-list .rs-link {
    font-size: 12px;
    margin-top: 5px;
  }
  .solution-disclaimer {
    color: #a2b9d5;
    font-size: 11px;
    margin-top: 24px;
  }
  .case-grid {
    gap: 42px 32px;
  }
  .home-case {
    min-width: 0;
  }
  .case-visual {
    display: block;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #e3eaf3;
    transition: border-color 0.2s;
  }
  .case-visual:hover {
    border-color: #749cf1;
  }
  .case-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    font-size: 11px;
    color: var(--rs-muted);
  }
  .case-demo {
    color: #4b6484;
    background: #eef3f8;
    border-radius: 3px;
    padding: 3px 8px;
  }
  .home-case h3 {
    font-size: 22px;
    font-weight: 650;
    margin-top: 8px;
    line-height: 1.5;
  }
  .home-case h3 a:hover {
    color: var(--rs-blue);
  }
  .home-case > p {
    font-size: 14px;
    line-height: 1.85;
    margin-top: 11px;
    color: var(--rs-muted);
  }
  .case-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
  }
  .case-detail {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    color: var(--rs-blue);
    flex-shrink: 0;
    border: 1px solid var(--rs-line);
    border-radius: 50%;
  }
  .case-detail:hover {
    background: #edf3ff;
  }
  .case-detail :global(svg) {
    width: 20px;
    height: 20px;
  }
  .about-layout {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 80px;
  }
  .about-brand {
    color: var(--rs-blue);
    font-size: 13px;
    margin-bottom: 20px;
  }
  .about-layout h2 {
    font-size: clamp(27px, 2.7vw, 37px);
    font-weight: 650;
    line-height: 1.7;
    letter-spacing: -0.03em;
  }
  .about-layout > div:last-child > p {
    color: var(--rs-muted);
    font-size: 16px;
    line-height: 2;
  }
  .about-method {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 22px;
    border-top: 1px solid var(--rs-line);
    padding-top: 23px;
    margin-top: 23px;
    font-size: 12px;
  }
  .about-layout .rs-link {
    margin-top: 20px;
  }
  .home-articles :global(.blog-grid) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }
  @media (max-width: 1199px) {
    .hero-layout {
      min-height: 530px;
    }
    h1 {
      font-size: 38px;
    }
    .hero-description {
      font-size: 14px;
    }
    .hero-scope {
      font-size: 10px;
    }
    .solution-layout {
      gap: 32px;
    }
    .service-grid {
      column-gap: 28px;
    }
    .home-service h3 {
      font-size: 18px;
    }
  }
  @media (max-width: 1023px) {
    .hero-layout {
      grid-template-columns: 1.05fr 1fr;
      min-height: 500px;
    }
    h1 {
      font-size: 32px;
    }
    .hero-description {
      font-size: 13px;
    }
    .hero-principles {
      gap: 25px;
    }
    .hero-brand-note {
      display: none !important;
    }
    .service-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .solution-layout {
      grid-template-columns: 1fr;
    }
    .solution-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
    .solution-list article {
      padding: 20px 0 0;
      border-top: 1px solid #ffffff24;
      border-bottom: 0;
      display: block;
    }
    .solution-list article:first-child {
      padding-top: 20px;
    }
    .solution-symbol {
      display: block;
      margin-bottom: 14px;
    }
    .solution-list h3 {
      font-size: 18px;
    }
    .solution-list p {
      font-size: 13px;
    }
    .featured-solution :global(.system-preview) {
      max-width: 580px;
      margin-inline: auto;
    }
    .about-layout {
      gap: 40px;
    }
    .home-articles :global(.blog-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .hero-layout {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      min-height: 0;
      padding-block: 40px 25px;
    }
    .hero-kicker {
      font-size: 11px;
      margin-bottom: 20px;
    }
    h1 {
      font-size: clamp(27px, 7.7vw, 40px);
      line-height: 1.55;
      letter-spacing: -0.04em;
    }
    .hero-description {
      margin-top: 20px;
      font-size: 14px;
      line-height: 1.95;
    }
    .desktop-break {
      display: none;
    }
    .hero-actions {
      margin-top: 25px;
      gap: 10px;
    }
    .hero-actions :global(.rs-button) {
      padding-inline: 19px;
      font-size: 14px;
      flex: 1;
    }
    .hero-scope {
      font-size: 10px;
      line-height: 1.85;
      margin-top: 20px;
      max-width: 300px;
    }
    .hero-principles {
      min-height: 58px;
      gap: 16px;
      justify-content: space-between;
      font-size: 10px;
    }
    .hero-principles > span {
      gap: 6px;
    }
    .service-grid {
      gap: 0 24px;
    }
    .home-service {
      padding-block: 24px 18px;
    }
    .home-service h3 {
      font-size: 17px;
    }
    .home-service p {
      font-size: 13px;
      min-height: 0;
    }
    .service-icon {
      width: 38px;
      height: 38px;
      margin-bottom: 15px;
    }
    .solution-list {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .solution-list article {
      padding-block: 24px;
      display: flex;
      gap: 17px;
    }
    .solution-list article:last-child {
      padding-bottom: 0;
    }
    .featured-solution {
      padding: 22px 16px 10px;
    }
    .featured-solution h3 {
      font-size: 21px;
    }
    .case-grid {
      gap: 34px;
    }
    .home-case h3 {
      font-size: 21px;
    }
    .about-layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .about-layout > div:last-child > p {
      font-size: 14px;
    }
    .about-method {
      gap: 10px 18px;
      font-size: 11px;
    }
    .home-articles :global(.blog-grid) {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }
  @media (max-width: 479px) {
    .service-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .home-service {
      display: grid;
      grid-template-columns: 38px minmax(0, 1fr);
      gap: 0 15px;
    }
    .service-icon {
      grid-row: 1 / 4;
      margin: 0;
    }
    .home-service p {
      margin-top: 8px;
    }
    .home-service .rs-link {
      grid-column: 2;
      margin-top: 4px;
    }
  }
</style>
