---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/reisun/PageIntro.astro';
import SystemPreview from '~/components/reisun/SystemPreview.astro';
import CTA from '~/components/reisun/CTA.astro';
import { solutions } from '~/data/solutions';

const metadata = {
  title: '解决方案｜工业采集、业务协同、合同审批与小程序',
  description:
    '了解 REISUN 的四类软件定制方案：工业设备采集与监控、ERP/OA 业务协同、合同管理与审批、小程序与互联网平台。查看业务问题、逻辑架构、功能模块与交付边界。',
};
---

<Layout metadata={metadata}>
  <PageIntro
    label="解决方案"
    title="让技术路径，对应真实业务。"
    description="从现场设备到部门协作，从合同审批到移动服务。用完整的业务链路组织系统，而不只是罗列功能。"
  />

  <div class="rs-container solution-directory">
    <nav aria-label="按业务场景选择方案">
      <ul>
        {
          solutions.map((solution) => (
            <li>
              <a href={`/solutions#${solution.id}`}>
                <Icon name={solution.icon} aria-hidden="true" />
                <span>{solution.title}</span>
                <Icon name="tabler:arrow-down" class="directory-arrow" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="directory-note">以下为定制开发的方案说明与概念演示，不是现成产品，也不代表真实客户部署。</p>
  </div>

  {
    solutions.map((solution, index) => (
      <section
        id={solution.id}
        class:list={['rs-section', 'solution-feature', { 'rs-section-soft': index % 2 === 1 }]}
        aria-labelledby={`${solution.id}-title`}
      >
        <div class="rs-container solution-layout">
          <div class="solution-copy">
            <Icon name={solution.icon} class="solution-icon" aria-hidden="true" />
            <h2 id={`${solution.id}-title`}>{solution.title}</h2>
            <p class="solution-summary">{solution.summary}</p>
            <p class="solution-audience">{solution.audience}</p>
            <div class="solution-focus">
              <h3>重点解决</h3>
              <ul>
                {solution.problems.map((problem) => (
                  <li>{problem.title}</li>
                ))}
              </ul>
            </div>
            <a class="rs-button" href={`/solutions/${solution.id}`}>
              查看完整方案
              <span class="sr-only">：{solution.title}</span>
              <Icon name="tabler:arrow-right" aria-hidden="true" />
            </a>
          </div>
          <figure class="solution-preview">
            <div class="preview-surface">
              <SystemPreview variant={solution.variant} compact />
            </div>
            <figcaption>{solution.previewCaption}</figcaption>
            <div class="solution-module-line">
              <span>方案包含</span>
              <ul>
                {solution.modules.map((module) => (
                  <li>{module.title}</li>
                ))}
              </ul>
            </div>
          </figure>
        </div>
      </section>
    ))
  }

  <section class="rs-section rs-section-dark selection-guide" aria-labelledby="selection-title">
    <div class="rs-container selection-layout">
      <div>
        <h2 id="selection-title">业务可能跨场景，系统不必彼此割裂。</h2>
        <p>
          设备数据可以进入业务台账，合同审批可以连接项目流程，小程序也可以成为已有平台的移动入口。方案可以组合，前提是先说清楚数据、流程和责任边界。
        </p>
      </div>
      <div class="selection-actions">
        <p>已有系统需要扩展，或暂时不确定从哪里开始？</p>
        <a class="rs-button rs-button-secondary" href="/services">查看技术服务与交付内容</a>
      </div>
    </div>
  </section>

  <CTA
    title="从你的业务链路，找到合适的切入点。"
    description="可以先说一个具体问题，也可以带上现有系统、流程或设备资料。方案从实际条件开始。"
  />
</Layout>

<style>
  .solution-directory {
    padding-bottom: 3rem;
  }
  .solution-directory ul,
  .solution-module-line ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .solution-directory nav > ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.5rem;
    border-top: 1px solid var(--rs-line, #dce4ef);
  }
  .solution-directory a {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 4.75rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rs-line, #dce4ef);
    color: var(--rs-ink, #172b46);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }
  .solution-directory a:hover,
  .solution-directory a:focus-visible {
    color: var(--rs-blue, #245eea);
  }
  .solution-directory :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
    color: var(--rs-blue, #245eea);
  }
  .solution-directory :global(.directory-arrow) {
    width: 1rem;
    height: 1rem;
    margin-left: auto;
    color: var(--rs-muted, #5b6b80);
  }
  .directory-note {
    margin-top: 1.25rem;
    color: var(--rs-muted, #5b6b80);
    font-size: 0.875rem;
    line-height: 1.85;
  }
  .solution-feature {
    scroll-margin-top: 7rem;
  }
  .solution-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .solution-icon {
    display: block;
    width: 2rem;
    height: 2rem;
    margin-bottom: 1.25rem;
    color: var(--rs-blue, #245eea);
  }
  .solution-copy h2,
  .selection-layout h2 {
    font-size: clamp(1.65rem, 2.6vw, 2.25rem);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.035em;
  }
  .solution-copy h2 {
    color: var(--rs-ink, #172b46);
  }
  .solution-summary {
    margin-top: 1.25rem;
    color: var(--rs-ink, #172b46);
    font-size: 1.1rem;
    line-height: 1.8;
  }
  .solution-audience {
    margin-top: 0.75rem;
    color: var(--rs-muted, #5b6b80);
    line-height: 1.85;
  }
  .solution-focus {
    margin-block: 1.75rem;
  }
  .solution-focus h3 {
    margin-bottom: 0.6rem;
    color: var(--rs-ink, #172b46);
    font-size: 0.875rem;
    font-weight: 650;
  }
  .solution-focus ul {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding-left: 1.15rem;
    list-style: disc;
    color: var(--rs-muted, #5b6b80);
    font-size: 0.95rem;
    line-height: 1.8;
  }
  .solution-copy > a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .solution-copy > a :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }
  .solution-preview {
    min-width: 0;
    margin: 0;
  }
  .preview-surface {
    min-width: 0;
    padding: clamp(1rem, 2.8vw, 2rem);
    border-radius: 0.75rem;
    background: var(--rs-navy, #102b50);
  }
  .solution-preview figcaption {
    margin-top: 1rem;
    color: var(--rs-muted, #5b6b80);
    font-size: 0.8125rem;
    line-height: 1.8;
  }
  .solution-module-line {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rs-line, #dce4ef);
  }
  .solution-module-line > span {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--rs-ink, #172b46);
    font-size: 0.8125rem;
    font-weight: 650;
  }
  .solution-module-line ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--rs-muted, #5b6b80);
    font-size: 0.875rem;
    line-height: 1.8;
  }
  .selection-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr);
    align-items: center;
    gap: 2.5rem 5rem;
  }
  .selection-layout h2 {
    color: #fff;
  }
  .selection-layout p {
    margin-top: 1.25rem;
    color: #c2d2e7;
    line-height: 1.85;
  }
  .selection-actions {
    border-left: 1px solid rgb(255 255 255 / 22%);
    padding-left: 2.5rem;
  }
  .selection-actions p {
    margin-top: 0;
    margin-bottom: 1.25rem;
  }
  .selection-actions a {
    display: inline-flex;
    border-color: rgb(255 255 255 / 38%);
    background: transparent;
    color: #fff;
  }
  .selection-actions a:hover {
    background: rgb(255 255 255 / 10%);
  }
  @media (max-width: 1000px) {
    .solution-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .solution-copy {
      max-width: 44rem;
    }
  }
  @media (max-width: 900px) {
    .selection-layout {
      gap: 2rem;
    }
    .selection-actions {
      padding-left: 1.5rem;
    }
  }
  @media (max-width: 700px) {
    .solution-directory nav > ul,
    .solution-layout,
    .selection-layout {
      grid-template-columns: 1fr;
    }
    .solution-directory a {
      min-height: 4rem;
      font-size: 0.95rem;
    }
    .solution-directory {
      padding-bottom: 2rem;
    }
    .solution-layout {
      gap: 2rem;
    }
    .selection-actions {
      padding-left: 0;
      padding-top: 1.5rem;
      border-left: 0;
      border-top: 1px solid rgb(255 255 255 / 22%);
    }
  }
</style>
