---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/reisun/PageIntro.astro';
import CTA from '~/components/reisun/CTA.astro';
import Process from '~/components/reisun/Process.astro';
import ServiceScenario from '~/components/reisun/ServiceScenario.astro';
import { services } from '~/data/services';
import { solutions } from '~/data/solutions';
import { cases } from '~/data/cases';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

const posts = await fetchPosts();

const metadata = {
  title: '技术服务｜企业软件、工业物联网与小程序定制开发',
  description:
    '了解 小斌opc Java 企业应用、工业设备采集、ERP/OA/合同、小程序、数据集成与维护的定制开发方向，查看客户准备资料、可约定交付与相关概念演示。',
};

const directoryLabels: Record<string, string> = {
  'java-enterprise': '企业应用',
  'industrial-iot': '设备采集',
  'enterprise-management': 'ERP / OA / 合同',
  'miniapp-mobile': '小程序 / 移动端',
  'data-integration': '数据集成',
  'system-upgrade': '升级维护',
};
const scenarioVariants: Partial<Record<string, 'industrial' | 'enterprise' | 'mobile'>> = {
  'industrial-iot': 'industrial',
  'enterprise-management': 'enterprise',
  'miniapp-mobile': 'mobile',
};
---

<Layout metadata={metadata}>
  <PageIntro
    variant="services"
    label="技术服务"
    title="从业务问题出发，把系统做实。"
    description="新建业务平台、规划设备采集，或改造已有系统。以下为可按项目评估的定制开发方向，先厘清问题与接入条件，再约定技术路径和交付范围。"
  >
    <Fragment slot="title"
      ><span class="rs-heading-phrase">从业务问题出发，</span><wbr /><span class="rs-heading-phrase">把系统做实。</span
      ></Fragment
    >
  </PageIntro>

  <section id="service-directory" class="service-directory" aria-labelledby="service-directory-title">
    <div class="rs-container">
      <div class="directory-heading">
        <h2 id="service-directory-title">找到与你的需求对应的服务</h2>
        <p>查看客户问题、实施方向和准备资料</p>
      </div>
      <nav aria-label="技术服务目录">
        <ul class="directory-grid">
          {
            services.map((service) => (
              <li>
                <a href={`/services#${service.id}`} aria-label={service.title}>
                  <Icon name={service.icon} class="directory-icon" aria-hidden="true" />
                  <span>{directoryLabels[service.id]}</span>
                  <Icon name="tabler:arrow-down" class="directory-arrow" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  {
    services.map((service, index) => {
      const scenarioVariant = scenarioVariants[service.id];
      return (
        <section
          id={service.id}
          class:list={[
            'rs-section',
            'service-detail',
            { 'rs-section-soft': index % 2 === 1, 'has-scenario': Boolean(scenarioVariant) },
          ]}
          aria-labelledby={`${service.id}-title`}
        >
          <div class="rs-container service-layout">
            <div class="service-overview">
              <div class="service-heading">
                <Icon name={service.icon} class="service-icon" aria-hidden="true" />
                <h2 id={`${service.id}-title`}>{service.title}</h2>
              </div>
              <p class="service-summary">{service.summary}</p>
              <div class="service-problem">
                <h3>业务问题与适用场景</h3>
                <p class="service-description">{service.description}</p>
                <ul class="service-scenarios" aria-label={`${service.title}适用场景`}>
                  {service.scenarios.map((scenario) => (
                    <li>{scenario}</li>
                  ))}
                </ul>
              </div>
            </div>
            {scenarioVariant && (
              <div class="service-illustration">
                <ServiceScenario variant={scenarioVariant} />
              </div>
            )}
            <div class="service-capabilities" role="group" aria-labelledby={`${service.id}-capabilities`}>
              <h3 id={`${service.id}-capabilities`} class="group-heading">
                拟实施方案与技术方向
              </h3>
              <div class="capability-list">
                {service.capabilities.map((capability) => (
                  <div class="capability">
                    <h4>{capability.title}</h4>
                    <p>{capability.description}</p>
                  </div>
                ))}
              </div>
            </div>
            <div class="service-package">
              <div class="service-delivery">
                <h3>可约定的交付内容</h3>
                <ul>
                  {service.deliverables.map((deliverable) => (
                    <li>
                      <Icon name="tabler:check" aria-hidden="true" />
                      <span>{deliverable}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="service-technical">
                <div class="technical-direction">
                  <h3>技术选型参考（按需评估）</h3>
                  <ul class="rs-tags" aria-label={`${service.title}技术方向`}>
                    {service.technologies.map((technology) => (
                      <li class="rs-tag">{technology}</li>
                    ))}
                  </ul>
                </div>
                <div class="service-scope">
                  <h3>范围与责任边界</h3>
                  <p>{service.scope}</p>
                </div>
                {service.preparation && service.preparation.length > 0 && (
                  <details class="service-preparation">
                    <summary>客户准备资料</summary>
                    <ul>
                      {service.preparation.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </div>
            </div>
            <div class="service-tail">
              <div class="related-solutions">
                <h3>相关解决方案</h3>
                <ul>
                  {solutions
                    .filter((solution) => service.solutionIds.includes(solution.id))
                    .map((solution) => (
                      <li>
                        <a class="rs-link" href={`/solutions/${solution.id}`}>
                          {solution.title}
                          <Icon name="tabler:chevron-right" aria-hidden="true" />
                        </a>
                      </li>
                    ))}
                </ul>
                {Boolean(service.caseIds?.length) && (
                  <div class="reference-group">
                    <h3>概念演示案例</h3>
                    <ul>
                      {cases
                        .filter((caseStudy) => service.caseIds?.includes(caseStudy.id))
                        .map((caseStudy) => (
                          <li>
                            <a class="rs-link" href={`/cases/${caseStudy.id}`}>
                              {caseStudy.title}（演示）
                              <Icon name="tabler:chevron-right" aria-hidden="true" />
                            </a>
                          </li>
                        ))}
                    </ul>
                  </div>
                )}
                {Boolean(service.postSlugs?.length) && (
                  <div class="reference-group">
                    <h3>延伸阅读</h3>
                    <ul>
                      {posts
                        .filter((post) => service.postSlugs?.includes(post.slug))
                        .map((post) => (
                          <li>
                            <a class="rs-link" href={getPermalink(post.permalink, 'post')}>
                              {post.title}
                              <Icon name="tabler:chevron-right" aria-hidden="true" />
                            </a>
                          </li>
                        ))}
                    </ul>
                  </div>
                )}
              </div>
              <div class="service-actions">
                <a class="rs-button rs-button-secondary service-contact" href="/contact">
                  了解这类项目的合作方式
                  <Icon name="tabler:arrow-up-right" aria-hidden="true" />
                </a>
                <a class="directory-return" href="/services#service-directory">
                  返回服务目录
                  <Icon name="tabler:arrow-up" aria-hidden="true" />
                </a>
              </div>
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="rs-section engagement-note" aria-labelledby="engagement-title">
    <div class="rs-container engagement-layout">
      <div>
        <h2 id="engagement-title">不必一开始就写出完整需求。</h2>
        <p class="rs-lead">先整理现在的工作方式、已有资料和最想改善的问题，再了解合作流程。</p>
      </div>
      <div class="engagement-content">
        <p>
          业务流程图、几张现有页面、设备点位表，或一份经常反复修改的
          Excel，都可以成为梳理需求的起点。我们会围绕业务目标、现状约束和优先级确认范围，而不是先给出一套固定功能清单。
        </p>
        <p>
          本页介绍服务定位与拟实施范围，不是现成软件或已完成项目的清单。关联案例均为概念演示，文章为技术设计参考；具体选型、功能、工期、费用、交付与维护以项目约定为准。
        </p>
        <p>
          可通过联系页的微信或邮箱交流需求；在线表单仅作演示，不接收提交。准备资料请先脱敏，不要填写密钥、账号凭据或未获授权的客户信息。
        </p>
        <a class="rs-button rs-button-secondary" href="/solutions">按业务场景了解方案</a>
      </div>
    </div>
  </section>

  <Process />
  <CTA
    title="从一个最值得解决的问题开始。"
    description="先了解需求梳理、范围确认与交付协作方式，再通过微信或邮箱沟通。在线表单仍仅作演示，不接收提交。"
  />
</Layout>

<style>
  .service-directory {
    padding-block: 24px;
    border-bottom: 1px solid var(--rs-line);
    background: var(--rs-white);
  }
  .directory-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 24px;
    margin-bottom: 14px;
  }
  .directory-heading h2 {
    color: var(--rs-ink);
    font-size: 15px;
    font-weight: 650;
  }
  .directory-heading p {
    color: var(--rs-muted);
    font-size: 13px;
  }
  .directory-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .directory-grid a {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    height: 100%;
    padding: 10px 12px;
    border: 1px solid var(--rs-line);
    border-radius: 4px;
    color: var(--rs-ink);
    background: var(--rs-soft);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
  }
  .directory-grid a:hover,
  .directory-grid a:focus-visible {
    color: var(--rs-blue);
    border-color: var(--rs-blue);
    background: var(--rs-white);
  }
  .directory-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--rs-blue);
  }
  .directory-arrow {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-left: auto;
    color: var(--rs-muted);
  }
  .service-detail {
    position: relative;
    scroll-margin-top: 110px;
  }
  .service-detail:target .service-heading {
    border-left: 3px solid var(--rs-blue);
    padding-left: 14px;
  }
  .service-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.3fr);
    gap: 32px 64px;
    align-items: start;
  }
  .service-layout > * {
    min-width: 0;
  }
  .service-heading {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .service-icon {
    width: 30px;
    height: 30px;
    margin-top: 7px;
    flex-shrink: 0;
    color: var(--rs-blue);
  }
  .service-overview h2,
  .engagement-layout h2 {
    color: var(--rs-ink);
    font-size: clamp(25px, 2.3vw, 32px);
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .service-summary,
  .service-description {
    text-wrap: balance;
  }
  .service-summary {
    margin-top: 20px;
    color: var(--rs-ink);
    font-size: 17px;
    line-height: 1.85;
  }
  .service-problem {
    margin-top: 24px;
  }
  .service-problem h3,
  .group-heading,
  .service-delivery h3,
  .technical-direction h3,
  .service-scope h3,
  .related-solutions h3 {
    margin-bottom: 12px;
    color: var(--rs-navy);
    font-size: 14px;
    font-weight: 650;
    line-height: 1.6;
  }
  .service-description,
  .capability p,
  .engagement-content p {
    color: var(--rs-muted);
    font-size: 15px;
    line-height: 1.9;
  }
  .service-scenarios {
    display: grid;
    gap: 5px;
    padding: 0 0 0 18px;
    margin: 14px 0 0;
    list-style: disc;
    color: var(--rs-muted);
    font-size: 15px;
    line-height: 1.8;
  }
  .service-scenarios li::marker {
    color: var(--rs-blue);
  }
  .group-heading {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rs-line);
    margin-bottom: 0;
  }
  .capability {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: 20px;
    padding-block: 22px;
    border-bottom: 1px solid var(--rs-line);
  }
  .capability h4 {
    color: var(--rs-ink);
    font-size: 17px;
    font-weight: 650;
    line-height: 1.65;
  }
  .has-scenario .service-layout {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 36px 48px;
  }
  .has-scenario .service-illustration {
    align-self: center;
  }
  .has-scenario .service-capabilities {
    grid-column: 1 / -1;
  }
  .has-scenario .capability-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }
  .has-scenario .capability {
    display: block;
    border-bottom: 0;
    padding-bottom: 0;
  }
  .has-scenario .capability h4 {
    margin-bottom: 10px;
  }
  .service-package {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-column: 1 / -1;
    border: 1px solid var(--rs-line);
    border-radius: 6px;
    background: var(--rs-white);
  }
  .service-delivery,
  .service-technical {
    padding: 26px 28px;
    min-width: 0;
  }
  .service-delivery {
    border-left: 3px solid var(--rs-blue);
    border-radius: 5px 0 0 5px;
    background: var(--rs-soft);
  }
  .service-detail.rs-section-soft .service-delivery {
    background: var(--rs-white);
  }
  .service-delivery ul {
    display: grid;
    gap: 10px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .service-delivery li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--rs-ink);
    font-size: 15px;
    line-height: 1.85;
  }
  .service-delivery li > span {
    text-wrap: balance;
  }
  .service-delivery :global(svg) {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
    margin-top: 5px;
    color: var(--rs-blue);
  }
  .service-technical {
    border-left: 1px solid var(--rs-line);
  }
  .technical-direction ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .technical-direction .rs-tag {
    font-size: 13px;
  }
  .service-scope {
    margin-top: 20px;
  }
  .service-scope h3 {
    margin-bottom: 6px;
  }
  .service-scope p {
    color: var(--rs-muted);
    font-size: 14px;
    line-height: 1.85;
  }
  .service-preparation {
    margin-top: 20px;
    padding-top: 12px;
    border-top: 1px solid var(--rs-line);
  }
  .service-preparation summary {
    min-height: 44px;
    padding-block: 10px;
    color: var(--rs-navy);
    font-size: 14px;
    font-weight: 650;
    line-height: 1.7;
    cursor: pointer;
  }
  .service-preparation ul {
    display: grid;
    gap: 8px;
    margin: 8px 0 0;
    padding-left: 18px;
    list-style: disc;
    color: var(--rs-muted);
    font-size: 14px;
    line-height: 1.85;
  }
  .reference-group {
    margin-top: 12px;
  }
  .service-tail {
    grid-column: 1 / -1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px 32px;
  }
  .related-solutions h3 {
    margin-bottom: 3px;
  }
  .related-solutions ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .related-solutions a {
    font-size: 14px;
  }
  .service-contact :global(svg),
  .related-solutions :global(svg),
  .directory-return :global(svg) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .service-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px 20px;
    flex-shrink: 0;
  }
  .service-contact {
    font-size: 14px;
    min-height: 44px;
    padding: 10px 16px;
  }
  .directory-return {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 44px;
    color: var(--rs-muted);
    font-size: 13px;
  }
  .directory-return:hover {
    color: var(--rs-blue);
    text-decoration: underline;
  }
  .engagement-note {
    background: var(--rs-soft);
    border-block: 1px solid var(--rs-line);
  }
  .engagement-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 32px 80px;
  }
  .engagement-layout .rs-lead {
    margin-top: 16px;
  }
  .engagement-content p + p {
    margin-top: 16px;
  }
  .engagement-content a {
    display: inline-flex;
    margin-top: 24px;
  }
  @media (min-width: 1120px) {
    .service-directory {
      position: sticky;
      top: 83px;
      z-index: 10;
      padding-block: 14px;
    }
    .directory-heading {
      margin-bottom: 10px;
    }
    .service-detail {
      scroll-margin-top: 130px;
    }
  }
  @media (max-width: 1119px) {
    .directory-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .service-layout,
    .has-scenario .service-layout {
      gap: 30px;
    }
    .capability {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .service-tail {
      flex-wrap: wrap;
    }
    .service-actions {
      justify-content: flex-start;
    }
    .engagement-layout {
      gap: 32px;
    }
  }
  @media (max-width: 767px) {
    .service-directory {
      padding-block: 22px;
    }
    .directory-heading {
      gap: 5px;
      margin-bottom: 16px;
    }
    .directory-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .directory-grid a {
      min-height: 62px;
      padding-inline: 10px;
      gap: 8px;
    }
    .directory-grid .directory-arrow {
      display: none;
    }
    .service-layout,
    .has-scenario .service-layout,
    .service-package,
    .has-scenario .capability-list,
    .engagement-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .service-layout,
    .has-scenario .service-layout {
      gap: 26px;
    }
    .service-heading {
      gap: 12px;
    }
    .service-icon {
      width: 26px;
      height: 26px;
      margin-top: 5px;
    }
    .service-summary {
      margin-top: 16px;
      font-size: 16px;
    }
    .service-problem {
      margin-top: 20px;
    }
    .has-scenario .capability-list {
      gap: 0;
    }
    .capability,
    .has-scenario .capability {
      padding-block: 18px;
      border-bottom: 1px solid var(--rs-line);
    }
    .has-scenario .capability:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }
    .service-delivery,
    .service-technical {
      padding: 22px 20px;
    }
    .service-delivery {
      border-radius: 5px 5px 0 0;
    }
    .service-technical {
      border-left: 0;
      border-top: 1px solid var(--rs-line);
    }
    .service-tail {
      gap: 18px;
    }
    .service-actions {
      width: 100%;
      justify-content: space-between;
      gap: 8px;
      border-top: 1px solid var(--rs-line);
      padding-top: 16px;
    }
  }
  @media (max-width: 359px) {
    .directory-grid a {
      padding-inline: 8px;
      gap: 6px;
      font-size: 13px;
    }
    .directory-icon {
      width: 18px;
      height: 18px;
    }
    .service-delivery,
    .service-technical {
      padding-inline: 16px;
    }
    .service-contact {
      padding-inline: 12px;
    }
  }
</style>
