---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/reisun/PageIntro.astro';
import CTA from '~/components/reisun/CTA.astro';
import Process from '~/components/reisun/Process.astro';
import { services } from '~/data/services';
import { solutions } from '~/data/solutions';

const metadata = {
  title: '技术服务｜企业软件、工业物联网与小程序定制开发',
  description:
    'REISUN 提供 Java 企业应用、工业物联网与设备采集、ERP/OA/合同、小程序与移动端、数据集成以及系统升级维护服务。了解适用场景、实施内容与交付边界。',
};
---

<Layout metadata={metadata}>
  <PageIntro
    label="技术服务"
    title="从业务问题出发，把系统做实。"
    description="新建一个业务平台，连接一批现场设备，或让已有系统继续向前。先厘清需要解决的问题，再确定适合的技术路径与交付范围。"
  >
    <Fragment slot="title"
      ><span class="rs-heading-phrase">从业务问题出发，</span><wbr /><span class="rs-heading-phrase">把系统做实。</span
      ></Fragment
    >
  </PageIntro>

  <section class="service-directory" aria-labelledby="service-directory-title">
    <div class="rs-container">
      <div class="directory-heading">
        <h2 id="service-directory-title">找到与你的需求对应的服务</h2>
        <p>查看具体内容、适用场景和交付说明</p>
      </div>
      <nav aria-label="技术服务目录">
        <ul class="directory-grid">
          {
            services.map((service) => (
              <li>
                <a href={`/services#${service.id}`}>
                  <Icon name={service.icon} class="directory-icon" aria-hidden="true" />
                  <span>{service.title}</span>
                  <Icon name="tabler:arrow-down" class="directory-arrow" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  {
    services.map((service, index) => (
      <section
        id={service.id}
        class:list={['rs-section', 'service-detail', { 'rs-section-soft': index % 2 === 1 }]}
        aria-labelledby={`${service.id}-title`}
      >
        <div class="rs-container service-layout">
          <div class="service-overview">
            <Icon name={service.icon} class="service-icon" aria-hidden="true" />
            <h2 id={`${service.id}-title`}>{service.title}</h2>
            <p class="service-summary">{service.summary}</p>
            <p class="service-description">{service.description}</p>
            <div class="service-scenarios">
              <h3>适用场景</h3>
              <ul>
                {service.scenarios.map((scenario) => (
                  <li>{scenario}</li>
                ))}
              </ul>
            </div>
            <a class="rs-link service-contact" href="/contact">
              沟通这类需求
              <Icon name="tabler:arrow-up-right" aria-hidden="true" />
            </a>
          </div>

          <div class="service-body">
            <div class="capability-list">
              {service.capabilities.map((capability) => (
                <div class="capability">
                  <h3>{capability.title}</h3>
                  <p>{capability.description}</p>
                </div>
              ))}
            </div>

            <div class="service-delivery">
              <h3>约定交付内容</h3>
              <ul>
                {service.deliverables.map((deliverable) => (
                  <li>
                    <Icon name="tabler:check" aria-hidden="true" />
                    <span>{deliverable}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="technical-direction">
              <h3>可选技术方向</h3>
              <ul class="rs-tags" aria-label={`${service.title}技术方向`}>
                {service.technologies.map((technology) => (
                  <li class="rs-tag">{technology}</li>
                ))}
              </ul>
            </div>
            <p class="service-scope">{service.scope}</p>

            <div class="related-solutions">
              <h3>相关解决方案</h3>
              <ul>
                {solutions
                  .filter((solution) => service.solutionIds.includes(solution.id))
                  .map((solution) => (
                    <li>
                      <a class="rs-link" href={`/solutions/${solution.id}`}>
                        {solution.title}
                        <Icon name="tabler:chevron-right" aria-hidden="true" />
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class="rs-section engagement-note" aria-labelledby="engagement-title">
    <div class="rs-container engagement-layout">
      <div>
        <h2 id="engagement-title">不必一开始就写出完整需求。</h2>
        <p class="rs-lead">带上你现在的工作方式、已有资料和最想改善的问题，就可以开始讨论。</p>
      </div>
      <div class="engagement-content">
        <p>
          业务流程图、几张现有页面、设备点位表，或一份经常反复修改的
          Excel，都可以成为梳理需求的起点。我们会围绕业务目标、现状约束和优先级确认范围，而不是先给出一套固定功能清单。
        </p>
        <p>
          具体功能、技术选型、工期、费用、源码交付与后续维护，以沟通后的范围说明和项目约定为准。涉及第三方平台、现场设备或存量系统的内容，需要先确认接入条件。
        </p>
        <a class="rs-button rs-button-secondary" href="/solutions">按业务场景了解方案</a>
      </div>
    </div>
  </section>

  <Process />
  <CTA
    title="从一个最值得解决的问题开始。"
    description="告诉我们你的业务场景、现有系统和希望达成的目标，一起明确下一步。"
  />
</Layout>

<style>
  .service-directory {
    padding-block: 1rem 3.5rem;
    background: var(--rs-white, #fff);
  }
  .directory-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-bottom: 1.5rem;
  }
  .directory-heading h2 {
    color: var(--rs-ink, #172b46);
    font-size: 1.05rem;
    font-weight: 650;
  }
  .directory-heading p {
    color: var(--rs-muted, #5b6b80);
    font-size: 0.875rem;
  }
  .directory-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 2rem;
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--rs-line, #dce4ef);
  }
  .directory-grid a {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rs-line, #dce4ef);
    color: var(--rs-ink, #172b46);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }
  .directory-grid a:hover,
  .directory-grid a:focus-visible {
    color: var(--rs-blue, #245eea);
  }
  .directory-icon {
    width: 1.45rem;
    height: 1.45rem;
    flex: 0 0 auto;
    color: var(--rs-blue, #245eea);
  }
  .directory-arrow {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    margin-left: auto;
    color: var(--rs-muted, #5b6b80);
  }
  .service-detail {
    scroll-margin-top: 7rem;
  }
  .service-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.5fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }
  .service-icon {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1.5rem;
    color: var(--rs-blue, #245eea);
  }
  .service-overview h2,
  .engagement-layout h2 {
    color: var(--rs-ink, #172b46);
    font-size: clamp(1.65rem, 2.8vw, 2.25rem);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.035em;
  }
  .service-summary {
    margin-top: 1.25rem;
    color: var(--rs-ink, #172b46);
    font-size: 1.1rem;
    line-height: 1.8;
  }
  .service-description,
  .capability p,
  .engagement-content p {
    color: var(--rs-muted, #5b6b80);
    line-height: 1.85;
  }
  .service-description {
    margin-top: 1rem;
  }
  .service-scenarios {
    margin-top: 2rem;
  }
  .service-scenarios h3,
  .service-delivery h3,
  .technical-direction h3,
  .related-solutions h3 {
    margin-bottom: 0.75rem;
    color: var(--rs-ink, #172b46);
    font-size: 0.875rem;
    font-weight: 650;
  }
  .service-scenarios ul {
    margin: 0;
    padding-left: 1.15rem;
    list-style: disc;
    color: var(--rs-muted, #5b6b80);
    line-height: 1.95;
  }
  .service-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    margin-top: 1.5rem;
  }
  .service-contact :global(svg),
  .related-solutions :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }
  .capability {
    padding-block: 1.35rem;
    border-top: 1px solid var(--rs-line, #dce4ef);
  }
  .capability:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .capability h3 {
    margin-bottom: 0.5rem;
    color: var(--rs-ink, #172b46);
    font-size: 1.15rem;
    font-weight: 650;
  }
  .service-delivery {
    margin-top: 0.75rem;
    padding: 1.5rem;
    border-left: 3px solid var(--rs-blue, #245eea);
    background: var(--rs-white, #fff);
  }
  .service-detail:not(.rs-section-soft) .service-delivery {
    background: var(--rs-soft, #f4f7fb);
  }
  .service-delivery ul {
    display: grid;
    gap: 0.65rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .service-delivery li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    color: var(--rs-ink, #172b46);
    font-size: 0.95rem;
    line-height: 1.8;
  }
  .service-delivery :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    margin-top: 0.35rem;
    color: var(--rs-blue, #245eea);
  }
  .technical-direction {
    margin-top: 1.75rem;
  }
  .technical-direction ul {
    list-style: none;
    padding: 0;
  }
  .service-scope {
    margin-top: 1rem;
    color: var(--rs-muted, #5b6b80);
    font-size: 0.875rem;
    line-height: 1.85;
  }
  .related-solutions {
    margin-top: 1.5rem;
  }
  .related-solutions ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .related-solutions a {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    min-height: 2.75rem;
    font-size: 0.875rem;
  }
  .engagement-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 2rem 5rem;
  }
  .engagement-layout .rs-lead {
    margin-top: 1rem;
  }
  .engagement-content p + p {
    margin-top: 1rem;
  }
  .engagement-content a {
    display: inline-flex;
    margin-top: 1.5rem;
  }
  @media (max-width: 900px) {
    .directory-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .service-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 2rem;
    }
    .engagement-layout {
      gap: 2rem;
    }
  }
  @media (max-width: 640px) {
    .service-directory {
      padding-bottom: 2.5rem;
    }
    .directory-grid {
      grid-template-columns: 1fr;
    }
    .directory-grid a {
      min-height: 4rem;
    }
    .service-layout,
    .engagement-layout {
      grid-template-columns: 1fr;
    }
    .service-icon {
      margin-bottom: 1rem;
    }
    .service-scenarios {
      margin-top: 1.5rem;
    }
    .capability:first-child {
      padding-top: 1.25rem;
      border-top: 1px solid var(--rs-line, #dce4ef);
    }
    .service-delivery {
      padding: 1.25rem;
    }
  }
</style>
