---
import { APP_BLOG } from 'astrowind:config';
import type { Post, Taxonomy } from '~/types';
import { fetchPosts } from '~/utils/blog';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';
import PageIntro from '~/components/reisun/PageIntro.astro';
import CTA from '~/components/reisun/CTA.astro';
import List from './List.astro';
import Pagination from './Pagination.astro';

export interface Props {
  title: string;
  description: string;
  posts: Post[];
  currentPage: number;
  lastPage: number;
  total: number;
  prevUrl?: string;
  nextUrl?: string;
  category?: Taxonomy;
  tag?: Taxonomy;
}
const { title, description, posts, currentPage, lastPage, total, prevUrl, nextUrl, category, tag } = Astro.props;
const allPosts = await fetchPosts();
const categories = [
  ...new Map(
    allPosts.flatMap((post) => (post.category ? [[post.category.slug, post.category] as const] : []))
  ).values(),
];
const tags = [
  ...new Map(allPosts.flatMap((post) => (post.tags || []).map((item) => [item.slug, item] as const))).values(),
];
---

<div class="blog-archive">
  <PageIntro title={title} description={description} label="技术与思考" />
  <section class="rs-container blog-archive-body" aria-label="技术文章">
    <div class="blog-archive-tools">
      <nav class="blog-categories" aria-label="按文章分类浏览">
        <a href={getBlogPermalink()} aria-current={!category && !tag ? 'page' : undefined}>全部文章</a>
        {
          APP_BLOG.category.isEnabled &&
            categories.map((item) => (
              <a
                href={getPermalink(item.slug, 'category')}
                aria-current={category?.slug === item.slug ? 'page' : undefined}
              >
                {item.title}
              </a>
            ))
        }
      </nav>
      <p class="blog-total">共 {total} 篇{currentPage > 1 ? `，第 ${currentPage} 页` : ''}</p>
    </div>
    {
      APP_BLOG.tag.isEnabled && tags.length > 0 && (
        <nav class="blog-topics" aria-label="按技术标签浏览">
          <span>技术话题</span>
          <ul>
            {tags.map((item) => (
              <li>
                <a href={getPermalink(item.slug, 'tag')} aria-current={tag?.slug === item.slug ? 'page' : undefined}>
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <p class="blog-demo-notice">
      以下为中文技术演示内容，用于交流设计方法与实施思路，不代表真实客户项目、交付记录或性能承诺。
    </p>
    <List posts={posts} featured={!category && !tag && currentPage === 1} />
    <Pagination {prevUrl} {nextUrl} {currentPage} {lastPage} />
    <div class="blog-subscribe">
      <span>希望用自己的阅读器跟进文章？</span><a href={getPermalink('/rss.xml')}>订阅 RSS</a><span>无需填写邮箱。</span
      >
    </div>
  </section>
  <CTA
    title="让技术方案回到你的业务现场"
    description="有设备接入、业务系统或数字化改造需求？可以先从问题、现状和约束聊起。"
  />
</div>

<style>
  .blog-archive {
    background: #fff;
    color: #172b46;
  }
  .blog-archive-body {
    padding-top: 20px;
    padding-bottom: 80px;
  }
  .blog-archive-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    border-bottom: 1px solid #dfe7f1;
    padding-bottom: 16px;
  }
  .blog-categories {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .blog-categories a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 8px 17px;
    border-radius: 5px;
    color: #5b6b80;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .blog-categories a[aria-current='page'] {
    background: #102b50;
    color: #fff;
  }
  .blog-categories a:hover:not([aria-current]) {
    color: #245eea;
    background: #f1f5fc;
  }
  .blog-total {
    margin: 0;
    font-size: 0.8125rem;
    color: #5b6b80;
  }
  .blog-topics {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 22px;
    margin: 16px 0;
    font-size: 0.8125rem;
  }
  .blog-topics > span {
    color: #5b6b80;
    flex-shrink: 0;
  }
  .blog-topics ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .blog-topics a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #52657c;
    text-decoration: none;
  }
  .blog-topics a:hover,
  .blog-topics a[aria-current='page'] {
    color: #245eea;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .blog-demo-notice {
    margin: 16px 0 36px;
    max-width: 850px;
    color: #64758a;
    font-size: 0.8125rem;
    line-height: 1.8;
  }
  .blog-subscribe {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid #dfe7f1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    font-size: 0.875rem;
    color: #5b6b80;
  }
  .blog-subscribe a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #245eea;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .blog-archive-body a:focus-visible {
    outline: 2px solid #245eea;
    outline-offset: 4px;
  }
  @media (max-width: 639px) {
    .blog-archive-body {
      padding-bottom: 56px;
    }
    .blog-categories a {
      padding-inline: 12px;
    }
  }
</style>
