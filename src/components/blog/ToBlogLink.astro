---
import { getBlogPermalink } from '~/utils/permalinks';
---

<div class="rs-container blog-back"><a href={getBlogPermalink()}>返回全部文章</a></div>
<style>
  .blog-back {
    padding-bottom: 48px;
  }
  .blog-back a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: #245eea;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .blog-back a:focus-visible {
    outline: 2px solid #245eea;
    outline-offset: 4px;
  }
</style>
