---
import { APP_BLOG } from 'astrowind:config';
import { getRelatedPosts } from '~/utils/blog';
import Grid from '~/components/blog/Grid.astro';
import type { Post } from '~/types';
import { getBlogPermalink } from '~/utils/permalinks';
export interface Props {
  post: Post;
}
const { post } = Astro.props;
const relatedPosts = APP_BLOG.isRelatedPostsEnabled ? await getRelatedPosts(post, APP_BLOG.relatedPostsCount || 4) : [];
---

{
  relatedPosts.length > 0 && (
    <section class="blog-related" aria-labelledby="related-posts-heading">
      <div class="rs-container">
        <div class="blog-related-heading">
          <div>
            <h2 id="related-posts-heading">延伸阅读</h2>
            <p>把问题继续想深一点</p>
          </div>
          <a href={getBlogPermalink()}>浏览全部文章</a>
        </div>
        <Grid posts={relatedPosts} />
      </div>
    </section>
  )
}
<style>
  .blog-related {
    padding: 64px 0 80px;
    background: #f4f7fb;
    color: #172b46;
  }
  .blog-related-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 20px;
    align-items: end;
    margin-bottom: 36px;
  }
  .blog-related-heading p {
    color: #5b6b80;
    font-size: 0.875rem;
    margin: 12px 0 0;
  }
  .blog-related-heading h2 {
    font-size: 1.9rem;
    line-height: 1.4;
    font-weight: 650;
    margin: 0;
  }
  .blog-related-heading > a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #245eea;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .blog-related-heading > a:focus-visible {
    outline: 2px solid #245eea;
    outline-offset: 4px;
  }
  @media (min-width: 1024px) {
    .blog-related :global(.blog-grid) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px;
    }
  }
  @media (max-width: 767px) {
    .blog-related {
      padding-block: 48px 56px;
    }
    .blog-related-heading {
      gap: 12px;
      margin-bottom: 28px;
    }
    .blog-related-heading h2 {
      font-size: 1.6rem;
    }
  }
</style>
