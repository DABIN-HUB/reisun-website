---
import type { Post } from '~/types';
import { fetchPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';
import { formatChineseDate } from './format';
export interface Props {
  post: Post;
}
const { post } = Astro.props;
const posts = await fetchPosts();
const index = posts.findIndex((item) => item.id === post.id);
const previous = index >= 0 ? posts[index + 1] : undefined;
const next = index > 0 ? posts[index - 1] : undefined;
---

{
  (previous || next) && (
    <div class="rs-container">
      <nav class="blog-post-navigation" aria-label="相邻文章">
        {previous ? (
          <a href={getPermalink(previous.permalink, 'post')} rel="prev">
            <span class="blog-adjacent-meta">
              <span>上一篇</span>
              <time datetime={previous.publishDate.toISOString()}>{formatChineseDate(previous.publishDate)}</time>
            </span>
            <strong>{previous.title}</strong>
          </a>
        ) : (
          <div />
        )}
        {next ? (
          <a href={getPermalink(next.permalink, 'post')} rel="next">
            <span class="blog-adjacent-meta">
              <span>下一篇</span>
              <time datetime={next.publishDate.toISOString()}>{formatChineseDate(next.publishDate)}</time>
            </span>
            <strong>{next.title}</strong>
          </a>
        ) : (
          <div />
        )}
      </nav>
    </div>
  )
}
<style>
  .blog-post-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 760px;
    gap: 32px;
    margin: 0 auto 40px;
    padding-top: 16px;
    border-top: 1px solid var(--rs-line);
  }
  .blog-post-navigation a {
    display: block;
    padding: 16px 0;
    min-width: 0;
    text-decoration: none;
  }
  .blog-adjacent-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
    margin-bottom: 10px;
    color: #586a80;
    font-size: 0.8125rem;
  }
  .blog-adjacent-meta > span {
    color: var(--rs-blue);
    font-weight: 600;
  }
  .blog-post-navigation strong {
    color: #172b46;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.8;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  .blog-post-navigation a:hover strong {
    color: #245eea;
  }
  .blog-post-navigation a:focus-visible {
    outline: 2px solid #245eea;
    outline-offset: 4px;
  }
  @media (max-width: 479px) {
    .blog-post-navigation {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
    .blog-post-navigation a + a {
      border-top: 1px solid var(--rs-line);
    }
    .blog-post-navigation > div {
      display: none;
    }
  }
</style>
