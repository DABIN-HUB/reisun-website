---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { formatChineseDate, formatReadingTime } from './format';

export interface Props {
  post: Post;
  featured?: boolean;
  headingLevel?: 'h2' | 'h3';
  compact?: boolean;
}

const { post, featured = false, headingLevel: Heading = 'h2', compact = false } = Astro.props;
const image = await findImage(post.image);
const link = APP_BLOG.post.isEnabled ? getPermalink(post.permalink, 'post') : undefined;
const readingTime = formatReadingTime(post.readingTime);
const titlePhrases = post.title.split(/(?<=[：，])/u);
---

<article
  class:list={[
    'blog-card',
    { 'blog-card-featured': featured, 'blog-card-compact': compact, 'blog-card-no-cover': !image },
  ]}
>
  {
    image && (
      <a
        class="blog-card-cover"
        href={link}
        aria-label={link ? `阅读：${post.title}` : undefined}
        tabindex={link ? 0 : -1}
      >
        <Image
          src={image}
          alt={post.imageAlt || post.title}
          width={1200}
          height={750}
          widths={[160, 240, 400, 640, 900, 1200]}
          sizes={
            compact
              ? '(min-width: 1024px) 380px, (min-width: 768px) 45vw, 84px'
              : featured
                ? '(min-width: 900px) 650px, (min-width: 640px) 50vw, 100vw'
                : '(min-width: 900px) 570px, (min-width: 640px) 50vw, 100vw'
          }
          format="webp"
          loading={featured ? 'eager' : 'lazy'}
          fetchpriority={featured ? 'high' : 'auto'}
          class="blog-card-image"
        />
      </a>
    )
  }
  <div class="blog-card-content">
    <div class="blog-card-meta">
      {
        post.category &&
          (APP_BLOG.category.isEnabled ? (
            <a
              class="blog-card-category"
              href={getPermalink(post.category.slug, 'category')}
              aria-label={`浏览分类：${post.category.title}`}
            >
              {post.category.title}
            </a>
          ) : (
            <span class="blog-card-category">{post.category.title}</span>
          ))
      }
      <time datetime={post.publishDate.toISOString()}>{formatChineseDate(post.publishDate)}</time>
      {readingTime && <span class="blog-card-time">{readingTime}</span>}
    </div>
    <Heading class="blog-card-title"
      >{
        link ? (
          <a href={link}>
            {compact ? titlePhrases.map((phrase) => <span class="blog-title-phrase">{phrase}</span>) : post.title}
          </a>
        ) : (
          post.title
        )
      }</Heading
    >
    {post.excerpt && <p class="blog-card-excerpt">{post.excerpt}</p>}
    <div class="blog-card-bottom">
      {
        link && (
          <a class="blog-card-read" href={link} aria-label={`阅读全文：${post.title}`}>
            阅读全文<span aria-hidden="true"> →</span>
          </a>
        )
      }
    </div>
    <div class="blog-card-tags"><PostTags tags={post.tags} title="标签" /></div>
  </div>
</article>

<style>
  .blog-card {
    min-width: 0;
    height: 100%;
    color: #172b46;
  }
  .blog-card-cover {
    display: block;
    overflow: hidden;
    background: #edf3fb;
    border: 1px solid #e3eaf3;
    border-radius: 7px;
    aspect-ratio: 8 / 5;
  }
  .blog-card-cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .blog-card-content {
    padding-top: 20px;
  }
  .blog-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 14px;
    font-size: 0.8125rem;
    color: #5b6b80;
    margin-bottom: 10px;
  }
  .blog-card-category {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #245eea;
    font-weight: 600;
  }
  .blog-card-title {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.5;
    letter-spacing: -0.025em;
    font-weight: 650;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  .blog-card-title a {
    color: inherit;
    text-decoration: none;
  }
  .blog-card-title a:hover {
    color: #245eea;
  }
  .blog-card-excerpt {
    margin: 14px 0 10px;
    color: #5b6b80;
    font-size: 0.9375rem;
    line-height: 1.85;
  }
  .blog-card-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 6px 16px;
    margin-top: 12px;
  }
  .blog-card-time {
    color: #586a80;
    font-size: 0.8125rem;
  }
  .blog-card-tags {
    margin-top: 6px;
  }
  .blog-card-read {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.875rem;
    font-weight: 600;
    color: #245eea;
    text-decoration: none;
  }
  .blog-card a:focus-visible {
    outline: 2px solid #245eea;
    outline-offset: 5px;
    border-radius: 3px;
  }
  .blog-card-featured {
    background: #f4f7fb;
    border-radius: 9px;
    overflow: hidden;
  }
  .blog-card-featured .blog-card-cover {
    border: 0;
    border-radius: 0;
  }
  .blog-card-featured .blog-card-cover :global(img) {
    object-fit: contain;
  }
  .blog-card-featured .blog-card-content {
    padding: 24px;
  }
  .blog-card-featured .blog-card-title {
    font-size: clamp(1.5rem, 2.5vw, 2.1rem);
  }

  @media (min-width: 900px) {
    .blog-card-featured {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      align-items: stretch;
    }
    .blog-card-featured .blog-card-cover {
      height: 100%;
      aspect-ratio: auto;
      min-height: 390px;
    }
    .blog-card-featured .blog-card-content {
      padding: 32px 40px;
      align-self: center;
    }
  }
  @media (max-width: 767px) {
    .blog-card-compact {
      display: grid;
      grid-template-columns: 84px minmax(0, 1fr);
      align-items: start;
      gap: 16px;
      padding-block: 20px;
      border-top: 1px solid var(--rs-line);
      height: auto;
    }
    .blog-card-compact.blog-card-no-cover {
      grid-template-columns: minmax(0, 1fr);
    }
    .blog-card-compact .blog-card-cover {
      margin-top: 4px;
      aspect-ratio: 1;
      border-radius: 5px;
    }
    .blog-card-compact .blog-card-content {
      display: flex;
      flex-direction: column;
      min-width: 0;
      padding: 0;
    }
    .blog-card-compact .blog-card-title {
      order: -1;
      font-size: 1rem;
      line-height: 1.65;
      letter-spacing: -0.015em;
    }
    .blog-card-compact .blog-title-phrase {
      display: inline-block;
      max-width: 100%;
    }
    .blog-card-compact .blog-card-meta {
      gap: 0 12px;
      margin: 4px 0 0;
      font-size: 0.75rem;
      line-height: 1.7;
    }
    .blog-card-compact .blog-card-category {
      min-height: 44px;
    }
    .blog-card-compact .blog-card-time {
      font-size: inherit;
    }
    .blog-card-compact .blog-card-excerpt,
    .blog-card-compact .blog-card-bottom,
    .blog-card-compact .blog-card-tags {
      display: none;
    }
  }
  @media (max-width: 380px) {
    .blog-card-featured .blog-card-content {
      padding: 20px;
    }
  }
</style>
