---
import { Icon } from 'astro-icon/components';
import type { SolutionArchitectureDefinition } from '~/data/solutions';

interface Props {
  architecture: SolutionArchitectureDefinition;
}

const { architecture } = Astro.props;
---

<figure class="solution-architecture" aria-label={architecture.title}>
  <ol class="architecture-layers" aria-label="方案分层与数据关联">
    {
      architecture.layers.map((layer, index) => (
        <li class="architecture-layer">
          <div class="layer-label">
            <h3>{layer.title}</h3>
            <p>{layer.description}</p>
          </div>
          <ul class="layer-items">
            {layer.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          {index < architecture.layers.length - 1 && (
            <span class="layer-connector" aria-hidden="true">
              <Icon name="tabler:arrow-down" />
            </span>
          )}
        </li>
      ))
    }
  </ol>
  <div class="architecture-foundation">
    <p>贯穿各层</p>
    <ul>
      {architecture.crossCutting.map((item) => <li>{item}</li>)}
    </ul>
  </div>
  <figcaption>逻辑架构示意 · 组件与部署方式按业务范围、现有环境和接入条件确定。</figcaption>
</figure>

<style>
  .solution-architecture {
    margin: 0;
    color: #fff;
  }
  .architecture-layers,
  .layer-items,
  .architecture-foundation ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .architecture-layers {
    display: grid;
    gap: 1.75rem;
  }
  .architecture-layer {
    position: relative;
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 1.75rem;
    border: 1px solid rgb(255 255 255 / 19%);
    border-left: 3px solid var(--rs-cyan, #63d7e7);
    border-radius: 0.5rem;
    background: rgb(255 255 255 / 5%);
  }
  .layer-label h3 {
    font-size: 1.1rem;
    line-height: 1.5;
    font-weight: 650;
    color: #fff;
  }
  .layer-label p {
    margin-top: 0.3rem;
    color: #b8cbe2;
    font-size: 0.8125rem;
    line-height: 1.7;
  }
  .layer-items {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .layer-items li {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.75rem;
    border-radius: 0.25rem;
    background: rgb(99 215 231 / 9%);
    color: #e4f5ff;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  .layer-connector {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    left: calc(50% - 0.875rem);
    bottom: -1.8rem;
    color: var(--rs-cyan, #63d7e7);
  }
  .layer-connector :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .architecture-foundation {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 1.5rem;
    padding: 1.25rem 1.75rem;
    border-block: 1px solid rgb(255 255 255 / 19%);
  }
  .architecture-foundation p {
    color: var(--rs-cyan, #63d7e7);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .architecture-foundation ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: #d0dff1;
    font-size: 0.875rem;
    line-height: 1.8;
  }
  figcaption {
    margin-top: 1rem;
    color: #b8cbe2;
    font-size: 0.8125rem;
    line-height: 1.8;
  }
  @media (max-width: 900px) {
    .architecture-layer {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: 1rem;
      padding: 1.25rem;
    }
    .layer-items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 540px) {
    .architecture-layer {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .layer-label {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.25rem 0.75rem;
    }
    .layer-label p {
      margin-top: 0;
    }
    .layer-items {
      gap: 0.5rem;
    }
    .layer-items li {
      padding: 0.65rem 0.5rem;
      font-size: 0.8125rem;
    }
    .architecture-foundation {
      padding-inline: 0;
    }
  }
</style>
