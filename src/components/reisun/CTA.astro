---
import Button from '~/components/ui/Button.astro';
import { hasConfirmedContact } from '~/data/brand';
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = '有软件开发需求？\n欢迎交流项目方案。',
  description = '准备业务流程、现有系统或设备资料，先了解开发范围、合作条件与下一步。',
} = Astro.props;
---

<section class="rs-cta">
  <div class="rs-container cta-inner">
    <div><h2>{title}</h2><p>{description}</p></div>
    <div class="cta-action">
      <Button href="/contact" text="了解合作方式" class="rs-button cta-button" /><span
        >{hasConfirmedContact() ? '请通过已确认的正式渠道联系' : '正式渠道待配置，本站暂不接收咨询'}</span
      >
    </div>
  </div>
</section>
<style>
  .rs-cta {
    background: var(--rs-blue);
    color: white;
    position: relative;
    overflow: hidden;
  }
  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding-block: 64px;
  }
  h2 {
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 650;
    line-height: 1.55;
    letter-spacing: -0.025em;
    white-space: pre-line;
  }
  p {
    color: #f1f5ff;
    margin-top: 18px;
    max-width: 620px;
  }
  .cta-action {
    flex-shrink: 0;
    display: grid;
    gap: 14px;
    text-align: center;
  }
  .cta-action :global(.cta-button) {
    color: var(--rs-blue);
    background: white;
    border-color: white;
    min-width: 185px;
  }
  .cta-action :global(.cta-button:hover) {
    background: #e9efff;
  }
  span {
    color: #f1f5ff;
    font-size: 13px;
  }
  @media (max-width: 767px) {
    .cta-inner {
      display: block;
      padding-block: 46px;
    }
    .cta-action {
      margin-top: 26px;
      text-align: left;
      justify-items: start;
    }
  }
</style>
