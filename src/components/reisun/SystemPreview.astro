---
export interface Props {
  variant?: 'industrial' | 'enterprise' | 'contract' | 'mobile';
  compact?: boolean;
}
const { variant = 'industrial', compact = false } = Astro.props;
const titles = {
  industrial: '工业设备数据中心',
  enterprise: '企业运营工作台',
  contract: '合同与流程协同',
  mobile: '移动业务服务',
};
const items = {
  industrial: ['设备总览', '数据采集', '告警中心', '历史趋势'],
  enterprise: ['运营总览', '采购管理', '库存管理', '协同审批'],
  contract: ['合同台账', '流程管理', '履约计划', '归档检索'],
  mobile: ['服务首页', '业务办理', '消息通知', '个人中心'],
};
const approvalSteps = [
  { title: '发起申请', state: '已发起', kind: 'done' },
  { title: '业务审核', state: '审核中', kind: 'current' },
  { title: '合同确认', state: '待处理', kind: 'waiting' },
  { title: '归档管理', state: '未归档', kind: 'waiting' },
];
---

<figure
  class:list={['system-preview', `preview-${variant}`, { compact }]}
  aria-label={`${titles[variant]}概念界面，以下均为演示数据`}
>
  <div class="window-bar">
    <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="window-name">REISUN / {titles[variant]}</span><span class="demo-label">演示界面</span>
  </div>
  <div class="window-body">
    <div class="system-sidebar" aria-hidden="true">
      <span class="mini-brand">R<span>REISUN</span></span>
      {
        items[variant].map((name, index) => (
          <span class:list={['sidebar-item', { selected: index === 0 }]}>
            <i />
            {name}
          </span>
        ))
      }
      <span class="sidebar-bottom">系统概念设计</span>
    </div>
    <div class="system-content">
      <div class="system-title"><strong>{titles[variant]}</strong><span>全部模拟</span></div>
      {
        variant === 'industrial' && (
          <>
            <div class="mini-stats">
              <div>
                <>
                  <span>设备接入</span>
                  <b>
                    24 <small>台</small>
                  </b>
                </>
              </div>
              <div>
                <>
                  <span>演示点位</span>
                  <b>
                    128 <small>个</small>
                  </b>
                </>
              </div>
              <div>
                <>
                  <span>采集状态</span>
                  <b class="status-ok">
                    <i />
                    模拟运行
                  </b>
                </>
              </div>
            </div>
            <div class="data-chain" aria-label="数据链路示意">
              <>
                <span>现场设备</span>
                <i>→</i>
                <span>协议采集</span>
                <i>→</i>
                <span>监控告警</span>
              </>
            </div>
            <div class="chart-panel">
              <div class="panel-label">
                <>
                  <span>
                    温度趋势 <small>°C</small>
                  </span>
                  <span class="legend">
                    <i />
                    产线 A <i />
                    产线 B
                  </span>
                </>
              </div>
              <div class="trend-plot">
                <div class="chart-scale" aria-hidden="true">
                  <>
                    <span>80</span>
                    <span>60</span>
                    <span>40</span>
                  </>
                </div>
                <svg
                  viewBox="0 0 440 118"
                  preserveAspectRatio="none"
                  role="img"
                  aria-label="两条产线的模拟温度曲线，单位摄氏度，横轴为09时至12时，不代表实时数据"
                >
                  <path d="M0 8h440M0 58h440M0 110h440" stroke="#e2eaf4" stroke-dasharray="3 4" />
                  <path
                    d="m0 93 20-10 20 2 20-16 20 5 20-17 20 8 20-24 20 11 20-17 20 7 20-15 20 18 20-2 20-12 20 7 20-16 20 12 20-3 20 10 20-22 20 8"
                    stroke="#3a70e5"
                    stroke-width="2.5"
                    fill="none"
                    vector-effect="non-scaling-stroke"
                  />
                  <path
                    d="m0 105 40-8 40 6 40-14 40 5 40-12 40 8 40-12 40 3 40-8 40 4"
                    stroke="#118b9e"
                    stroke-width="2"
                    fill="none"
                    vector-effect="non-scaling-stroke"
                  />
                </svg>
              </div>
              <div class="chart-axis">
                <>
                  <span>09:00</span>
                  <span>10:00</span>
                  <span>11:00</span>
                  <span>12:00</span>
                </>
              </div>
            </div>
            <div class="device-row">
              <>
                <span>
                  <i />
                  装配产线 A
                </span>
                <span>Modbus TCP</span>
                <em>采集模拟</em>
              </>
            </div>
            {!compact && (
              <div class="device-detail">
                <div>
                  <span>
                    <i class="offline" />
                    空压机 B
                  </span>
                  <span>连接中断</span>
                  <em>离线模拟</em>
                </div>
                <p>
                  <b>告警示例</b>空压机 B 连接中断 <span>待确认</span>
                </p>
              </div>
            )}
          </>
        )
      }
      {
        variant === 'enterprise' && (
          <>
            <div class="mini-stats">
              <div>
                <>
                  <span>待处理单据</span>
                  <b>
                    12 <small>项</small>
                  </b>
                </>
              </div>
              <div>
                <>
                  <span>库存预警</span>
                  <b>
                    03 <small>项</small>
                  </b>
                </>
              </div>
              <div>
                <>
                  <span>业务状态</span>
                  <b class="status-ok">流程协同</b>
                </>
              </div>
            </div>
            <div class="erp-columns">
              <div class="chart-panel">
                <div class="panel-label">
                  <>
                    <span>单据分类</span>
                    <small>模拟数量</small>
                  </>
                </div>
                <div class="bar-chart" role="img" aria-label="采购、库存、合同三类演示单据的相对数量，非真实经营数据">
                  <>
                    <i style="height:58%" />
                    <i style="height:82%" />
                    <i style="height:45%" />
                  </>
                </div>
                <div class="bar-axis">
                  <>
                    <span>采购</span>
                    <span>库存</span>
                    <span>合同</span>
                  </>
                </div>
              </div>
              <div class="pending-list">
                <>
                  <strong>待办单据</strong>
                  <span>
                    采购申请<em>待审批</em>
                  </span>
                  <span>
                    物料入库<em>待确认</em>
                  </span>
                  <span>
                    合同归档<em>待归档</em>
                  </span>
                </>
              </div>
            </div>
            <div class="data-chain erp-chain" aria-label="业务单据关联示意">
              <>
                <span>采购申请</span>
                <i>→</i>
                <span>审批入库</span>
                <i>→</i>
                <span>数据汇总</span>
              </>
            </div>
            {!compact && <p class="simulation-note">单据状态、部门协同与统计汇总关联展示，数值与业务均为模拟。</p>}
          </>
        )
      }
      {
        variant === 'contract' && (
          <>
            <div class="contract-document">
              <>
                <span class="document-icon" aria-hidden="true">
                  ≡
                </span>
                <div>
                  <>
                    <strong>设备采购合同</strong>
                    <p>RS-DEMO-001 · 演示合同</p>
                  </>
                </div>
                <span class="review-status">审核中</span>
              </>
            </div>
            <ol class="approval-flow" aria-label="演示合同审批进度">
              {approvalSteps.map((step, index) => (
                <li class={step.kind} aria-current={step.kind === 'current' ? 'step' : undefined}>
                  <span class="approval-node">{step.kind === 'done' ? '✓' : index + 1}</span>
                  <strong>{step.title}</strong>
                  <small>{step.state}</small>
                </li>
              ))}
            </ol>
            <dl class="contract-lines">
              <dd>交付确认 → 付款审批</dd>
              {!compact && (
                <>
                  <dt>权限管理</dt>
                  <dd>按角色和数据范围授权</dd>
                </>
              )}
            </dl>
          </>
        )
      }
      {
        variant === 'mobile' && (
          <div class="mobile-scene">
            <div class="phone">
              <span class="phone-top">
                9:41
                <i />
              </span>
              <div class="phone-heading">
                你好，欢迎使用
                <>
                  <br />
                  <strong>企业业务服务</strong>
                </>
              </div>
              <div class="phone-banner">
                业务办理
                <>
                  <br />
                  <span>从移动端开始</span>
                </>
              </div>
              <div class="phone-apps">
                {['业务办理', '进度查询', '资料管理', '消息中心'].map((name, index) => (
                  <span>
                    <i aria-hidden="true">{['↗', '≡', '▤', '·'][index]}</i>
                    {name}
                  </span>
                ))}
              </div>
              <div class="phone-bottom">
                <>
                  <span>首页</span>
                  <span>服务</span>
                  <span>我的</span>
                </>
              </div>
            </div>
            <div class="mobile-notes">
              <>
                <span class="mobile-scene-label">前后端协同</span>
                <strong>
                  移动办理
                  <br />
                  后台协同
                </strong>
                <ol>
                  <>
                    <li>
                      <>
                        <i>1</i>
                        <span>
                          移动提交<small>小程序 / H5</small>
                        </span>
                      </>
                    </li>
                    <li>
                      <>
                        <i>2</i>
                        <span>
                          后台受理
                          <small>
                            <>
                              <span>统一</span>
                              <wbr />
                              <span>业务规则</span>
                            </>
                          </small>
                        </span>
                      </>
                    </li>
                    <li>
                      <>
                        <i>3</i>
                        <span>
                          进度反馈
                          <small>
                            <>
                              <span>状态同步</span>
                              <wbr />
                              <span>展示</span>
                            </>
                          </small>
                        </span>
                      </>
                    </li>
                  </>
                </ol>
                <p>
                  仅为流程示意
                  <br />
                  不实际办理业务
                </p>
              </>
            </div>
          </div>
        )
      }
    </div>
  </div>
  <figcaption>原创概念界面 · 全部模拟数据 · 非真实系统截图</figcaption>
</figure>

<style>
  .system-preview {
    container: rs-system / inline-size;
    background: #e9eff8;
    padding: 18px;
    border-radius: 9px;
    color: #253c59;
    width: 100%;
    min-width: 0;
    font-family: var(--aw-font-sans);
    line-height: 1.6;
  }
  .compact {
    padding: 14px;
  }
  .window-bar {
    min-height: 38px;
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid #d4dfed;
    border-bottom: 0;
    background: white;
    border-radius: 7px 7px 0 0;
    padding: 8px 12px;
    font-size: 10px;
  }
  .window-dots {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }
  .window-dots i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #b5c5da;
  }
  .window-name {
    min-width: 0;
  }
  .demo-label {
    margin-left: auto;
    white-space: nowrap;
    color: #526881;
    font-size: 10px;
  }
  .window-body {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    border: 1px solid #d4dfed;
    border-radius: 0 0 6px 6px;
    overflow: hidden;
    background: #f4f7fb;
  }
  .system-sidebar {
    display: flex;
    flex-direction: column;
    gap: 7px;
    background: #173758;
    color: #c1d1e4;
    padding: 17px 7px;
  }
  .mini-brand {
    display: flex;
    align-items: center;
    gap: 5px;
    font-weight: 750;
    font-size: 17px;
    color: var(--rs-cyan);
    margin: 0 4px 17px;
  }
  .mini-brand > span {
    font-size: 9px;
    color: white;
  }
  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 9px;
    padding: 8px 4px;
    border-radius: 3px;
    white-space: nowrap;
  }
  .sidebar-item > i {
    height: 6px;
    width: 6px;
    border: 1px solid currentColor;
    border-radius: 1px;
    flex-shrink: 0;
  }
  .sidebar-item.selected {
    background: #2a5d94;
    color: white;
  }
  .sidebar-bottom {
    margin: auto 0 0 4px;
    padding-top: 18px;
    font-size: 9px;
  }
  .system-content {
    padding: 18px;
    min-width: 0;
  }
  .system-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 13px;
  }
  .system-title strong {
    font-size: 13px;
    font-weight: 650;
  }
  .system-title > span {
    font-size: 10px;
    color: #526881;
    white-space: nowrap;
  }
  .mini-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 11px;
  }
  .mini-stats > div {
    background: white;
    border: 1px solid #e0e7f1;
    border-radius: 4px;
    padding: 9px 10px;
    min-width: 0;
  }
  .mini-stats span {
    display: block;
    font-size: 10px;
    color: #526881;
    white-space: nowrap;
  }
  .mini-stats b {
    display: block;
    font-size: 23px;
    font-weight: 650;
    line-height: 1.6;
    white-space: nowrap;
  }
  .mini-stats small {
    font-size: 10px;
    font-weight: 400;
  }
  .mini-stats .status-ok {
    font-size: 12px;
    color: #16715f;
    padding-top: 9px;
  }
  .status-ok i,
  .device-row i,
  .device-detail i {
    display: inline-block;
    width: 5px;
    height: 5px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #228573;
    margin-right: 4px;
  }
  .data-chain {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 5px;
    background: #eaf1ff;
    border: 1px solid #dce6f8;
    color: #315786;
    padding: 7px 10px;
    font-size: 10px;
    margin-bottom: 11px;
  }
  .data-chain span {
    white-space: nowrap;
  }
  .data-chain i {
    font-style: normal;
    color: #6585b2;
  }
  .chart-panel {
    background: white;
    border: 1px solid #e0e7f1;
    border-radius: 4px;
    padding: 11px;
    min-width: 0;
  }
  .panel-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    margin-bottom: 10px;
  }
  .panel-label small {
    font-size: 9px;
    color: #526881;
    font-weight: 400;
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #526881;
    font-size: 9px;
  }
  .legend i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3a70e5;
    margin-left: 5px;
  }
  .legend i:last-of-type {
    background: #118b9e;
  }
  .trend-plot {
    display: grid;
    grid-template-columns: 23px minmax(0, 1fr);
    gap: 3px;
    height: 101px;
  }
  .chart-scale {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #526881;
    font-size: 9px;
    padding-bottom: 4px;
  }
  .trend-plot svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .chart-axis {
    display: flex;
    justify-content: space-between;
    color: #526881;
    font-size: 9px;
    margin: 5px 0 0 26px;
  }
  .device-row,
  .device-detail > div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    color: #526881;
    margin-top: 10px;
  }
  .device-row > span:first-child,
  .device-detail > div > span:first-child {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }
  .device-row em,
  .device-detail em {
    font-style: normal;
    font-size: 9px;
    background: #e4f2ee;
    color: #246b59;
    padding: 2px 6px;
    white-space: nowrap;
    border-radius: 3px;
  }
  .device-detail i.offline {
    background: #b07824;
  }
  .device-detail em {
    color: #815818;
    background: #fff2da;
  }
  .device-detail p {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    margin-top: 11px;
    padding: 9px;
    background: #fff5e4;
    border-left: 2px solid #c78d32;
    color: #71511c;
  }
  .device-detail p b {
    font-weight: 600;
  }
  .device-detail p span {
    margin-left: auto;
  }
  .erp-columns {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 10px;
  }
  .bar-chart {
    height: 90px;
    display: flex;
    align-items: end;
    justify-content: space-around;
    gap: 15px;
    border-bottom: 1px solid #d9e3f0;
    padding-inline: 8px;
    background: repeating-linear-gradient(to top, transparent 0, transparent 28px, #eaf0f8 29px, transparent 30px);
  }
  .bar-chart i {
    flex: 1;
    max-width: 35px;
    background: #527de0;
    border-radius: 2px 2px 0 0;
  }
  .bar-chart i:nth-child(2) {
    background: #248b9d;
  }
  .bar-chart i:nth-child(3) {
    background: #95b1e8;
  }
  .bar-axis {
    display: flex;
    justify-content: space-around;
    gap: 4px;
    font-size: 9px;
    color: #526881;
    margin-top: 6px;
  }
  .pending-list {
    background: white;
    border: 1px solid #e0e7f1;
    border-radius: 4px;
    padding: 11px;
    min-width: 0;
  }
  .pending-list strong {
    display: block;
    font-size: 11px;
    font-weight: 550;
    margin-bottom: 8px;
  }
  .pending-list > span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    font-size: 10px;
    border-top: 1px solid #e9eef5;
    padding-block: 9px;
  }
  .pending-list em {
    font-style: normal;
    font-size: 9px;
    color: #825c1c;
    background: #fff3df;
    padding: 2px 5px;
    white-space: nowrap;
  }
  .erp-chain {
    margin: 11px 0 0;
  }
  .simulation-note {
    color: #526881;
    font-size: 11px;
    margin-top: 13px;
  }
  .contract-document {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 13px 12px;
    background: white;
    border: 1px solid #e0e7f1;
    border-radius: 4px;
  }
  .document-icon {
    color: #4272d5;
    background: #edf3ff;
    padding: 0 9px;
    font-size: 28px;
  }
  .contract-document > div {
    min-width: 0;
  }
  .contract-document strong {
    font-size: 12px;
    font-weight: 600;
  }
  .contract-document p {
    font-size: 9px;
    color: #526881;
    margin-top: 4px;
  }
  .review-status {
    margin-left: auto;
    white-space: nowrap;
    padding: 3px 7px;
    background: #eaf1ff;
    color: #315eae;
    font-size: 10px;
    border-radius: 3px;
  }
  .approval-flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 23px 0;
    padding: 0;
    list-style: none;
  }
  .approval-flow li {
    text-align: center;
    position: relative;
  }
  .approval-flow li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 15px;
    left: calc(50% + 20px);
    right: calc(-50% + 20px);
    height: 1px;
    background: #c7d6eb;
  }
  .approval-node {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid #c7d6eb;
    border-radius: 50%;
    background: white;
    color: #526881;
    font-size: 11px;
  }
  .done .approval-node {
    color: #1b7563;
    background: #e7f4ee;
    border-color: #a9d3c8;
  }
  .done::after {
    background: #95c6b7 !important;
  }
  .current .approval-node {
    color: white;
    background: #386de0;
    border-color: #386de0;
    box-shadow: 0 0 0 4px #e4ecfc;
  }
  .approval-flow strong {
    display: block;
    font-size: 10px;
    font-weight: 550;
    margin-top: 9px;
  }
  .approval-flow small {
    display: block;
    font-size: 9px;
    color: #526881;
    margin-top: 4px;
  }
  .current small {
    color: #245ac9;
