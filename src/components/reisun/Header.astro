---
import Logo from '~/components/Logo.astro';
import { headerData } from '~/navigation';
import { hasConfirmedContact } from '~/data/brand';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) =>
  href === '/'
    ? path === '/'
    : path === href ||
      path.startsWith(`${href}/`) ||
      (href === '/blog' && (path.startsWith('/category/') || path.startsWith('/tag/')));
---

<reisun-header>
  <header class="rs-header">
    <div class="rs-container header-inner">
      <a href="/" class="brand-home" aria-label="小斌opc 首页"><Logo /></a>
      <button
        type="button"
        class="menu-toggle"
        aria-label="展开导航菜单"
        aria-expanded="false"
        aria-controls="primary-navigation"
        hidden><span></span><span></span></button
      >
      <nav id="primary-navigation" aria-label="主导航">
        <ul>
          {
            headerData.links.map((link) => (
              <li>
                <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>
                  {link.text}
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href={headerData.actions[0].href}
          class="rs-button nav-cta"
          title={hasConfirmedContact() ? '了解合作与正式联系渠道' : '了解合作方式，正式联系渠道待配置'}
          >{headerData.actions[0].text}<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"
            ><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.5"></path></svg
          ></a
        >
      </nav>
    </div>
  </header>
</reisun-header>
<script>
  class ReisunHeader extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('button');
      const nav = this.querySelector<HTMLElement>('nav');
      if (!button || !nav) return;
      button.hidden = false;
      this.classList.add('enhanced');
      const setOpen = (open: boolean, focus = false) => {
        this.classList.toggle('is-open', open);
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? '关闭导航菜单' : '展开导航菜单');
        if (focus) button.focus();
      };
      button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
      nav.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a')) setOpen(false);
      });
      const key = (event: KeyboardEvent) => {
        if (event.key === 'Escape' && this.classList.contains('is-open')) setOpen(false, true);
      };
      const outside = (event: MouseEvent) => {
        if (!this.contains(event.target as Node)) setOpen(false);
      };
      const scroll = () => this.classList.toggle('is-scrolled', window.scrollY > 24);
      const media = window.matchMedia('(min-width: 1120px)');
      const resize = () => {
        const hadFocus = nav.contains(document.activeElement);
        const toggleFocused = document.activeElement === button;
        setOpen(false);
        if (!media.matches && hadFocus) button.focus();
        else if (media.matches && toggleFocused) nav.querySelector<HTMLAnchorElement>('a')?.focus();
      };
      document.addEventListener('keydown', key);
      document.addEventListener('click', outside);
      window.addEventListener('scroll', scroll, { passive: true });
      media.addEventListener('change', resize);
      scroll();
      this.cleanup = () => {
        document.removeEventListener('keydown', key);
        document.removeEventListener('click', outside);
        window.removeEventListener('scroll', scroll);
        media.removeEventListener('change', resize);
      };
    }
    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get('reisun-header')) customElements.define('reisun-header', ReisunHeader);
</script>
<style>
  reisun-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: block;
    background: #ffffff;
    border-bottom: 1px solid var(--rs-line);
    transition: box-shadow 0.2s;
  }
  reisun-header.is-scrolled {
    box-shadow: 0 6px 26px #102b5010;
  }
  .header-inner {
    min-height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand-home {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  ul {
    display: flex;
    gap: 27px;
  }
  li a {
    display: flex;
    align-items: center;
    font-size: 14px;
    font-weight: 550;
    color: var(--rs-ink);
    min-height: 82px;
    position: relative;
    white-space: nowrap;
  }
  li a[aria-current] {
    color: var(--rs-blue);
  }
  li a[aria-current]::after {
    content: '';
    position: absolute;
    height: 3px;
    background: var(--rs-blue);
    bottom: -1px;
    left: 0;
    right: 0;
  }
  li a:hover {
    color: var(--rs-blue);
  }
  .nav-cta {
    font-size: 14px;
    padding: 10px 19px;
    min-height: 44px;
    gap: 12px;
  }
  .nav-cta svg {
    width: 18px;
    height: 18px;
  }
  .menu-toggle {
    display: none;
  }
  @media (max-width: 1119px) {
    .header-inner {
      flex-wrap: wrap;
      min-height: 72px;
      padding-block: 12px;
    }
    .menu-toggle:not([hidden]) {
      display: grid;
      align-content: center;
      gap: 6px;
      height: 44px;
      width: 44px;
      border: 1px solid var(--rs-line);
      border-radius: 5px;
      padding: 11px;
    }
    .menu-toggle span {
      height: 2px;
      width: 20px;
      background: var(--rs-ink);
      transition: transform 0.2s;
    }
    nav {
      width: 100%;
      display: block;
      padding-block: 8px 16px;
    }
    .enhanced:not(.is-open) nav {
      display: none;
    }
    ul {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 20px;
    }
    li a {
      min-height: 49px;
      border-bottom: 1px solid var(--rs-line);
      font-size: 15px;
    }
    li a[aria-current]::after {
      display: none;
    }
    .nav-cta {
      margin-top: 20px;
    }
    .is-open .menu-toggle span:first-child {
      transform: translateY(4px) rotate(45deg);
    }
    .is-open .menu-toggle span:last-child {
      transform: translateY(-4px) rotate(-45deg);
    }
  }
  @media (max-width: 359px) {
    ul {
      grid-template-columns: 1fr;
    }
    .is-open nav {
      max-height: calc(100dvh - 92px);
      overflow-y: auto;
    }
  }
</style>
