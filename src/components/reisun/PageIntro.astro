---
import IntroVisual, { type IntroVariant } from '~/components/reisun/IntroVisual.astro';

export interface Props {
  title: string;
  description: string;
  label?: string;
  variant?: IntroVariant;
}
const { title, description, label, variant } = Astro.props;
---

<section class:list={['rs-page-intro', variant && `intro-${variant}`]}>
  <div class:list={['rs-container', { 'intro-layout': variant }]}>
    <div class="intro-copy">
      {label && <p class="intro-label">{label}</p>}
      <h1>{Astro.slots.has('title') ? <slot name="title" /> : title}</h1>
      <p class="rs-lead">{description}</p>
    </div>
    {variant && <IntroVisual variant={variant} />}
  </div>
</section>

<style>
  .rs-page-intro {
    position: relative;
    background: var(--rs-soft);
    padding-block: 68px 64px;
    border-bottom: 1px solid var(--rs-line);
  }
  .intro-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 256px;
    align-items: center;
    gap: 48px;
  }
  .intro-copy {
    min-width: 0;
  }
  .intro-label {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--rs-blue);
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 18px;
  }
  .intro-label::before {
    content: '';
    width: 22px;
    height: 2px;
    background: currentColor;
    flex-shrink: 0;
  }
  h1 {
    max-width: 920px;
    font-size: clamp(30px, 3.5vw, 46px);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .rs-lead {
    max-width: 730px;
    margin-top: 22px;
    text-wrap: balance;
  }
  .intro-services {
    background: #f5f8ff;
  }
  .intro-solutions {
    background: var(--rs-navy);
    color: white;
    border-bottom-color: #2a466b;
  }
  .intro-solutions .intro-label {
    color: var(--rs-cyan);
  }
  .intro-solutions .rs-lead {
    color: #c5d7ed;
  }
  .intro-cases {
    background: #f1f5fb;
  }
  .intro-articles {
    background: white;
    border-bottom: 1px solid #c8d7eb;
  }
  .intro-about {
    background: #edf3f9;
  }
  .intro-contact {
    background: #f5f8fc;
    border-bottom-color: #d7e2ef;
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .intro-layout {
      grid-template-columns: minmax(0, 1fr) 220px;
      gap: 28px;
    }
    h1 {
      font-size: 32px;
    }
    .rs-lead {
      font-size: 15px;
    }
  }
  @media (max-width: 767px) {
    .rs-page-intro {
      padding-block: 40px 34px;
    }
    .intro-layout {
      display: block;
    }
    .intro-label {
      margin-bottom: 15px;
      font-size: 12px;
    }
    .rs-lead {
      margin-top: 18px;
      text-wrap: pretty;
    }
  }
</style>
