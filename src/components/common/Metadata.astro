---
import merge from 'lodash.merge';
import { SEO } from 'astro-seo';

import type { SEOProps } from 'astro-seo';

import { SITE, METADATA, I18N } from 'astrowind:config';
import type { MetaData, MetaDataOpenGraph } from '~/types';
import { getCanonical } from '~/utils/permalinks';
import { isProductionSearchBuild, isPublicIndexingPath } from '~/utils/indexing';

import { adaptOpenGraphImages } from '~/utils/images';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical: requestedCanonical,
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

const publicSection = isPublicIndexingPath(Astro.url.pathname, SITE.base);
const productionIndexing = isProductionSearchBuild(import.meta.env.PROD, import.meta.env.MODE, {
  SITE_ENV: import.meta.env.SITE_ENV ?? process.env.SITE_ENV,
  CI: import.meta.env.CI ?? process.env.CI,
  CF_PAGES: import.meta.env.CF_PAGES ?? process.env.CF_PAGES,
  CF_PAGES_BRANCH: import.meta.env.CF_PAGES_BRANCH ?? process.env.CF_PAGES_BRANCH,
  SITE_PRODUCTION_BRANCH: import.meta.env.SITE_PRODUCTION_BRANCH ?? process.env.SITE_PRODUCTION_BRANCH,
  VERCEL: import.meta.env.VERCEL ?? process.env.VERCEL,
  VERCEL_ENV: import.meta.env.VERCEL_ENV ?? process.env.VERCEL_ENV,
  NETLIFY: import.meta.env.NETLIFY ?? process.env.NETLIFY,
  CONTEXT: import.meta.env.CONTEXT ?? process.env.CONTEXT,
});
const requestedIndex = robots.index ?? METADATA?.robots?.index;
const canonical = String(getCanonical(publicSection ? Astro.url.pathname : (requestedCanonical ?? Astro.url.pathname)));

const mergedOg: MetaDataOpenGraph = merge(
  {
    url: canonical,
    siteName: SITE?.name,
    images: [],
    locale: I18N?.language || 'en',
    type: 'website',
  },
  METADATA?.openGraph,
  { url: canonical, ...openGraph }
);

const adaptedOg = await adaptOpenGraphImages(mergedOg, Astro.site);

const firstImage = adaptedOg?.images?.[0];

function buildOpenGraph(og: MetaDataOpenGraph): SEOProps['openGraph'] | undefined {
  if (!og) return undefined;

  const imageUrl = firstImage?.url || '';
  if (!imageUrl) return undefined;

  return {
    basic: {
      title: title || METADATA?.title?.default || '',
      type: og.type || 'website',
      image: imageUrl,
      url: og.url,
    },
    optional: {
      description: description || METADATA?.description,
      locale: og.locale,
      siteName: og.siteName,
    },
    image: {
      url: imageUrl,
      width: firstImage?.width,
      height: firstImage?.height,
      alt: title || METADATA?.title?.default || '',
    },
    ...(og.type === 'article' && og.article ? { article: og.article } : {}),
  };
}

const mergedTwitter = merge(
  {
    card: (adaptedOg?.images?.length ? 'summary_large_image' : 'summary') as 'summary_large_image' | 'summary',
  },
  METADATA?.twitter
    ? {
        card: METADATA.twitter.cardType as 'summary_large_image' | 'summary' | undefined,
        site: METADATA.twitter.site,
        creator: METADATA.twitter.handle,
      }
    : {},
  twitter
    ? {
        card: twitter.cardType as 'summary_large_image' | 'summary' | undefined,
        site: twitter.site,
        creator: twitter.handle,
      }
    : {}
);

const seoProps: SEOProps = {
  title: title || METADATA?.title?.default || '',
  titleTemplate: ignoreTitleTemplate ? '%s' : METADATA?.title?.template || '%s',
  canonical: canonical,
  noindex: !productionIndexing || !publicSection || requestedIndex !== true,
  nofollow: !productionIndexing
    ? true
    : typeof robots?.follow !== 'undefined'
      ? !robots.follow
      : typeof METADATA?.robots?.follow !== 'undefined'
        ? !METADATA.robots.follow
        : true,
  description: description || METADATA?.description,
  openGraph: buildOpenGraph(adaptedOg),
  twitter: mergedTwitter,
  surpressWarnings: true,
};
---

<SEO {...seoProps} />
